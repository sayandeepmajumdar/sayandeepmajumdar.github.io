  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:app": "vite build",
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/tailwind.css -o ./assets/css/site.min.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./src/tailwind.css -o ./assets/css/site.min.css --watch",
    "build": "npm run build:css && vite build && cp -r dist/assets/toolbox assets/ && cp dist/tools/index.html tools/index.html",
    "preview": "vite preview"
  },
