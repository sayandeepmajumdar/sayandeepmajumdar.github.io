---
import RasoiLayout from '../../layouts/RasoiLayout.astro';
import Navbar from '../../components/rasoi/Navbar.astro';
import Footer from '../../components/rasoi/Footer.astro';
import RecipeCard from '../../components/rasoi/RecipeCard.astro';
import { RecipeExplorer } from '../../components/rasoi/RecipeExplorer';
import { RECIPES } from '../../data/rasoi/recipes';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Explore Authentic Indian Recipes — Rasoi',
  url: 'https://sayandeepmajumdar.github.io/rasoi/explore/',
  description:
    'Search, filter, and discover 50+ authentic regional Indian recipes across North Indian, South Indian, Bengali, Punjabi, Gujarati, and Maharashtrian cuisines.',
  publisher: {
    '@type': 'Organization',
    name: 'Rasoi',
    url: 'https://sayandeepmajumdar.github.io/rasoi/',
  },
};
---

<RasoiLayout
  title="Explore 50+ Authentic Indian Recipes — Rasoi"
  description="Search, filter, and discover 50+ authentic regional Indian recipes across North Indian, South Indian, Bengali, Punjabi, Gujarati, and Maharashtrian cuisines."
  canonicalUrl="https://sayandeepmajumdar.github.io/rasoi/explore/"
  structuredData={structuredData}
>
  <Navbar slot="header" currentPath="/rasoi/explore/" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    {/* Page Header */}
    <div class="max-w-3xl mb-8 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-100 text-rose-900 text-xs font-bold uppercase tracking-wider">
        <span>✨ Recipe Discovery</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-extrabold text-stone-900 tracking-tight">
        Explore Indian Recipes
      </h1>
      <p class="text-stone-600 text-sm sm:text-base">
        Filter through regional cuisines, dietary choices, cooking times, and spice preferences
        to find your next delicious homemade meal.
      </p>
    </div>

    {/* Interactive Island: Live Search, Filters, and Recipe Results */}
    <RecipeExplorer client:load />

    {/* Static Fallback for Search Engines and JS-Disabled Users */}
    <noscript>
      <div class="mt-12 pt-8 border-t border-stone-200">
        <h2 class="font-serif text-2xl font-bold text-stone-900 mb-6">
          Complete Recipe Index ({RECIPES.length} Authentic Dishes)
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {RECIPES.map((recipe) => (
            <RecipeCard recipe={recipe} />
          ))}
        </div>
      </div>
    </noscript>
  </div>

  <Footer slot="footer" />
</RasoiLayout>
