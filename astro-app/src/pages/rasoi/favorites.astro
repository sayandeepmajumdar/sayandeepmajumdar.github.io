---
import RasoiLayout from '../../layouts/RasoiLayout.astro';
import Navbar from '../../components/rasoi/Navbar.astro';
import Footer from '../../components/rasoi/Footer.astro';
import { FavoritesExplorer } from '../../components/rasoi/FavoritesExplorer';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Saved Favorite Indian Recipes — Rasoi',
  url: 'https://sayandeepmajumdar.github.io/rasoi/favorites/',
  description: 'Your personal collection of saved favorite authentic Indian recipes.',
  publisher: {
    '@type': 'Organization',
    name: 'Rasoi',
    url: 'https://sayandeepmajumdar.github.io/rasoi/',
  },
};
---

<RasoiLayout
  title="My Saved Indian Recipes — Rasoi"
  description="Your personal collection of saved favorite authentic Indian recipes."
  canonicalUrl="https://sayandeepmajumdar.github.io/rasoi/favorites/"
  structuredData={structuredData}
>
  <Navbar slot="header" currentPath="/rasoi/favorites/" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    {/* Header */}
    <div class="pb-6 mb-8 border-b border-stone-200">
      <div class="flex items-center gap-2 text-rose-900 text-xs font-bold uppercase tracking-wider mb-1">
        <span>❤️ My Recipe Box</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight">
        Saved Favorite Recipes
      </h1>
      <p class="text-stone-500 text-xs sm:text-sm mt-1">
        Your personal collection of favorite Indian dishes, saved right in your browser.
      </p>
    </div>

    {/* Interactive Favorites Explorer Island */}
    <FavoritesExplorer client:load />

    {/* Non-JS note */}
    <noscript>
      <div class="p-6 rounded-2xl bg-amber-50 border border-amber-200 text-stone-800 text-sm">
        <p>
          Saved recipes use your browser's local storage. Please enable JavaScript to manage and view
          your saved recipe favorites, or browse all dishes in our{' '}
          <a href="/rasoi/explore/" class="font-bold text-rose-900 underline">
            Recipe Explorer
          </a>.
        </p>
      </div>
    </noscript>
  </div>

  <Footer slot="footer" />
</RasoiLayout>
