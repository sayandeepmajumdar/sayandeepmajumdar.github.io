---
import ToolsLayout from '../../layouts/ToolsLayout.astro';
import { TOOLS } from '../../data/tools/tools';
import { CATEGORIES } from '../../data/tools/categories';
import { ToolsExplorer } from '../../components/tools/islands/ToolsExplorer';
import { DynamicIcon } from '../../components/tools/common/DynamicIcon';

const title = "Toolzy — 80+ Free, 100% Client-Side Developer Tools | Privacy-First";
const description = "Discover 80+ free, client-side developer tools: JSON formatters, Base64/JWT decoders, regex testers, cryptography suites, SQL builders, diagram visualizers, and financial calculators. 100% private, zero server calls.";
const canonicalUrl = "https://sayandeepmajumdar.github.io/tools/";
---

<ToolsLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  currentPath="/tools/"
>
  <div class="space-y-12 pb-16">
    {/* Hero Section */}
    <section class="relative pt-12 pb-8 px-4 sm:px-6 max-w-7xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-surface border border-line shadow-xs mb-6 text-muted">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>100% Client-Side • Zero Telemetry • 80+ Utilities</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-ink tracking-tight font-sans max-w-4xl mx-auto leading-tight sm:leading-tight">
        Private Developer Tools for <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 dark:from-blue-400 dark:via-indigo-400 dark:to-purple-400 bg-clip-text text-transparent">Modern Engineers</span>
      </h1>

      <p class="text-sm sm:text-base md:text-lg text-muted mt-4 max-w-2xl mx-auto leading-relaxed">
        Professional formatters, encoders, cryptography suites, SQL visualizers, and calculators.
        Every tool processes data strictly inside your browser. No server calls, no telemetry, no tracking.
      </p>

      {/* Quick Category Badges */}
      <div class="flex flex-wrap items-center justify-center gap-2 mt-8 max-w-3xl mx-auto">
        {CATEGORIES.slice(0, 8).map((cat) => (
          <a
            href={`/tools/${cat.slug}/`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-surface hover:bg-surface-alt border border-line text-xs font-semibold text-muted hover:text-ink transition-colors shadow-2xs"
          >
            <DynamicIcon name={cat.icon} className="w-3.5 h-3.5 text-accent" />
            <span>{cat.name}</span>
          </a>
        ))}
        <a
          href="#explore-all"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-accent-light text-accent text-xs font-semibold hover:bg-accent/20 transition-colors"
        >
          <span>All 12 Categories →</span>
        </a>
      </div>
    </section>

    {/* Interactive Tools Catalog (Pre-rendered on server, hydrated on client) */}
    <section id="explore-all" class="relative">
      <ToolsExplorer
        client:load
        initialCategory="all"
        initialTools={TOOLS}
        categories={CATEGORIES}
      />
    </section>

    {/* Value Propositions & Privacy Assurance */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 border-t border-line/60">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
          Engineered for Speed, Privacy, and Reliability
        </h2>
        <p class="text-xs sm:text-sm text-muted mt-2">
          Why thousands of developers and privacy-conscious users bookmark Toolzy.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-surface border border-line space-y-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink">Zero Server Logs</h3>
          <p class="text-xs text-muted leading-relaxed">
            All crypto key generation, AES ciphering, and JSON formatting execute 100% in your browser using standard Web Cryptography and V8 engines. No external API calls.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface border border-line space-y-3">
          <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-600 dark:text-blue-400 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink">Sub-Millisecond Execution</h3>
          <p class="text-xs text-muted leading-relaxed">
            Eliminate network latency. Transforms and syntax validations run immediately with zero round-trip overhead, even when working offline.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface border border-line space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-600 dark:text-purple-400 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-ink">Modular &amp; Self-Contained</h3>
          <p class="text-xs text-muted leading-relaxed">
            Every single utility can be used embedded in the Toolzy suite or opened standalone with zero external dependencies for distraction-free workflows.
          </p>
        </div>
      </div>
    </section>
  </div>
</ToolsLayout>
