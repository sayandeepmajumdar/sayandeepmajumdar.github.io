---
import YatraLayout from '../../layouts/YatraLayout.astro';
import { InteractiveIndiaMap } from '../../components/yatra/islands/InteractiveIndiaMap';
import TravelStylesCarousel from '../../components/yatra/TravelStylesCarousel.astro';
import TrendingSection from '../../components/yatra/TrendingSection.astro';
import HiddenGemsSection from '../../components/yatra/HiddenGemsSection.astro';
import { RecentlyExplored } from '../../components/yatra/islands/RecentlyExplored';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'YATRA — Discover India',
  url: 'https://sayandeepmajumdar.github.io/yatra/',
  applicationCategory: 'TravelApplication',
  description:
    'Traverse 100+ authentic destinations across 36 States & Union Territories of India on an interactive SVG map with animated flight routes.',
  operatingSystem: 'All',
  author: {
    '@type': 'Person',
    name: 'Sayandeep Majumdar',
    url: 'https://sayandeepmajumdar.github.io/',
  },
};
---

<YatraLayout
  title="YATRA — Discover India | Interactive SVG Map & Travel Guide"
  description="Traverse 100+ authentic Indian destinations on an interactive SVG map with animated flight routes, royal citadels, high Himalayas, and sacred waters."
  jsonLd={jsonLd}
>
  <div class="w-full min-h-screen pb-20 space-y-16">
    <!-- Top Hero Section -->
    <section class="relative pt-10 sm:pt-14 pb-4 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center flex flex-col items-center">
      <!-- Decorative Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full glass-panel border border-amber-500/30 text-xs font-semibold text-amber-400 mb-5 shadow-lg shadow-amber-500/10">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
        <span>Interactive Travel Discovery of India</span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold font-display tracking-tight text-white max-w-4xl leading-[1.15]">
        Where will{' '}
        <span class="bg-gradient-to-r from-orange-400 via-amber-300 to-yellow-400 bg-clip-text text-transparent">
          India
        </span>{' '}
        take you?
      </h1>

      <!-- Subtitle -->
      <p class="mt-4 sm:mt-5 text-sm sm:text-lg text-stone-300 max-w-2xl font-light leading-relaxed">
        Traverse 100+ authentic destinations across 36 States & Union Territories. Watch real-time flight routes, explore royal forts, high Himalayas, and sacred coastal waters.
      </p>
    </section>

    <!-- Main Interactive Map Showcase Island -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveIndiaMap client:load />
    </section>

    <!-- Travel Styles Carousel -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <TravelStylesCarousel />
    </section>

    <!-- Trending Destinations Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <TrendingSection />
    </section>

    <!-- Hidden Gems Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <HiddenGemsSection />
    </section>

    <!-- Recently Explored Section Island -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <RecentlyExplored client:idle />
    </section>
  </div>
</YatraLayout>
