---
import YatraLayout from '../../../layouts/YatraLayout.astro';
import { YatraExplorer } from '../../../components/yatra/islands/YatraExplorer';
import { DESTINATIONS } from '../../../data/yatra/destinations';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'All Indian Destinations — Yatra',
  description: 'Complete directory of 100+ authentic destinations across India categorized by region, style, and season.',
  url: 'https://sayandeepmajumdar.github.io/yatra/explore/',
  numberOfItems: DESTINATIONS.length,
  itemListElement: DESTINATIONS.map((d, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'TouristDestination',
      name: d.name,
      description: d.description,
      url: `https://sayandeepmajumdar.github.io/yatra/destination/${d.id}/`,
      image: d.image,
      address: {
        '@type': 'PostalAddress',
        addressRegion: d.state,
        addressCountry: 'IN',
      },
    },
  })),
};
---

<YatraLayout
  title="Explore All Destinations — YATRA | Discover India Matrix"
  description="Browse 100+ authentic destinations across India. Filter by Himalayas, Goa beaches, royal Rajasthan forts, and Kerala backwaters."
  jsonLd={jsonLd}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <!-- Header -->
    <div>
      <div class="text-xs font-semibold text-amber-500 uppercase tracking-wider mb-1">
        Discovery Matrix
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-display text-white">
        Explore All Destinations
      </h1>
      <p class="text-stone-400 text-sm sm:text-base mt-2 max-w-2xl">
        Filter through 100+ authentic destinations by region, travel mood, and landscape. Click "Fly on Map" to initiate the real-time flight animation.
      </p>
    </div>

    <!-- Interactive Explorer Island -->
    <YatraExplorer client:load />

    <!-- Static Noscript Fallback Grid for 100% JS-Disabled SEO Indexing -->
    <noscript>
      <div class="mt-12 space-y-6">
        <h2 class="text-2xl font-bold font-display text-white border-b border-white/10 pb-3">
          All Destinations Directory ({DESTINATIONS.length} Places)
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {DESTINATIONS.map((dest) => (
            <div class="rounded-2xl glass-card overflow-hidden border border-white/10 p-5 space-y-3">
              <img
                src={dest.image}
                alt={dest.name}
                loading="lazy"
                class="w-full h-44 object-cover rounded-xl"
              />
              <div class="flex items-center justify-between text-xs text-amber-400">
                <span>{dest.region} India</span>
                <span>{dest.categories[0]}</span>
              </div>
              <h3 class="text-xl font-bold text-white">
                <a href={`/yatra/destination/${dest.id}/`} class="hover:underline">
                  {dest.name}
                </a>
              </h3>
              <p class="text-xs text-stone-300">
                {dest.state} • Best: {dest.bestTime} • Stay: {dest.idealDuration}
              </p>
              <p class="text-xs text-stone-400 leading-relaxed">
                {dest.description}
              </p>
              <div class="pt-2 flex items-center gap-2 text-xs font-semibold">
                <a
                  href={`/yatra/destination/${dest.id}/`}
                  class="text-amber-400 hover:underline"
                >
                  Read Travel Guide →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </noscript>
  </div>
</YatraLayout>
