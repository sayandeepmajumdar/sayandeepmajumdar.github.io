---
import GamesLayout from '../../../layouts/GamesLayout.astro';
import { GAMES } from '../../../data/games/games';
import { GAME_CATEGORIES } from '../../../data/games/categories';
import type { GameCategory, Game } from '../../../types/games';
import { GamesExplorer } from '../../../components/games/islands/GamesExplorer';

export function getStaticPaths() {
  return GAME_CATEGORIES.map((category) => {
    const categoryGames = GAMES.filter((g) => g.categories.includes(category.id));
    return {
      params: { category: category.slug },
      props: { category, games: categoryGames },
    };
  });
}

interface Props {
  category: GameCategory;
  games: Game[];
}

const { category, games } = Astro.props;

const title = `${category.name} Games — ArcadeLab | Free Browser Games`;
const description = `${category.description} Play ${games.length} free browser games powered by WebRTC P2P netcode and HTML5 Canvas.`;
const canonicalUrl = `https://sayandeepmajumdar.github.io/games/${category.slug}/`;
const currentPath = `/games/${category.slug}/`;
---

<GamesLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  currentPath={currentPath}
>
  <div class="space-y-8">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-2 text-xs text-muted" aria-label="Breadcrumb">
      <a href="/games/" class="hover:text-ink transition-colors">ArcadeLab</a>
      <span class="text-line">/</span>
      <span class="text-ink font-semibold">{category.name}</span>
    </nav>

    {/* Category Banner */}
    <div class="p-6 sm:p-8 rounded-3xl bg-surface border border-line shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-start gap-4">
          <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-3xl shrink-0 shadow-inner">
            {category.icon}
          </div>

          <div>
            <div class="flex items-center gap-2.5 flex-wrap">
              <h1 class="text-2xl sm:text-3xl font-black text-ink tracking-tight">
                {category.name} Games
              </h1>
              <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-500 dark:text-indigo-400 border border-indigo-500/20">
                {games.length} {games.length === 1 ? 'game' : 'games'}
              </span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                100% Free
              </span>
            </div>
            <p class="text-xs sm:text-sm text-muted mt-2 leading-relaxed max-w-2xl">
              {category.description}
            </p>
          </div>
        </div>

        <a
          href="/games/"
          class="inline-flex items-center gap-1 text-xs font-semibold text-indigo-500 dark:text-indigo-400 hover:underline self-start sm:self-auto shrink-0"
        >
          <span>← All 17 games</span>
        </a>
      </div>
    </div>

    {/* Interactive Explorer Focused on Category */}
    <div class="pt-2">
      <GamesExplorer
        client:load
        initialGames={GAMES}
        categories={GAME_CATEGORIES}
        initialCategory={category.id}
      />
    </div>
  </div>
</GamesLayout>
