---
import GamesLayout from '../../layouts/GamesLayout.astro';
import { GAMES } from '../../data/games/games';
import { GAME_CATEGORIES } from '../../data/games/categories';
import { GamesExplorer } from '../../components/games/islands/GamesExplorer';

const title = "ArcadeLab — A playground for browser games. | sayandeep.dev";
const description = "ArcadeLab — Real-time multiplayer duels, 3D WebGL sandboxes, and retro arcade games powered by instant WebRTC peer-to-peer data channels with zero server overhead.";
const canonicalUrl = "https://sayandeepmajumdar.github.io/games/";
---

<GamesLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  currentPath="/games/"
>
  <div class="space-y-10">
    {/* Hero Banner */}
    <div class="text-center space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-gradient-to-r from-indigo-500/10 via-purple-500/10 to-pink-500/10 border border-indigo-500/20 text-indigo-500 dark:text-indigo-400 font-mono text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>🕹️ WebRTC Peer-to-Peer • 100% Client-Side • 17 Games</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-ink">
        Arcade<span class="bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 bg-clip-text text-transparent">Lab</span>
      </h1>

      <p class="text-base sm:text-xl font-bold text-ink tracking-tight">
        A playground for browser games.
      </p>

      <p class="text-xs sm:text-sm text-muted max-w-lg mx-auto leading-relaxed">
        Real-time multiplayer duels, logic puzzles, and casual arcade games powered directly by browser peer-to-peer data channels with zero server overhead.
      </p>
    </div>

    {/* Interactive Games Explorer Island */}
    <GamesExplorer
      client:load
      initialGames={GAMES}
      categories={GAME_CATEGORIES}
      initialCategory="all"
    />

    {/* Feature Pillars */}
    <section class="pt-12 border-t border-line/60 grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div class="p-5 rounded-2xl bg-surface border border-line space-y-2">
        <div class="text-2xl">🌐</div>
        <h3 class="font-bold text-sm text-ink">Direct WebRTC Netcode</h3>
        <p class="text-xs text-muted leading-relaxed">
          Connect directly to opponents using peer-to-peer data channels. Low-latency tick synchronization with zero centralized game servers.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-surface border border-line space-y-2">
        <div class="text-2xl">⚡</div>
        <h3 class="font-bold text-sm text-ink">Canvas &amp; WebGL Rendering</h3>
        <p class="text-xs text-muted leading-relaxed">
          Smooth 60FPS physics, vector canvas explosions, Three.js 3D raycast motorsport, and chunked voxel meshing.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-surface border border-line space-y-2">
        <div class="text-2xl">🛡️</div>
        <h3 class="font-bold text-sm text-ink">Private &amp; Self-Contained</h3>
        <p class="text-xs text-muted leading-relaxed">
          Every game is 100% client-side with zero telemetry, zero accounts, and zero tracking. Play instantly in any modern browser.
        </p>
      </div>
    </section>
  </div>
</GamesLayout>
