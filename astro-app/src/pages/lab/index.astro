---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { aiProjects } from '../../data/portfolio/profile';
---

<PortfolioLayout
  title="The Lab — Things I Build For Fun | Sayandeep Majumdar"
  description="Explore personal side projects, developer tools, interactive calculators, browser games, and cultural archives built by Sayandeep Majumdar."
  canonicalUrl="https://sayandeepmajumdar.github.io/lab/"
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-12 sm:py-16 md:py-24">
    <!-- Breadcrumb -->
    <div class="reveal mb-6">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-muted hover:text-accent transition-colors"
      >
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Portfolio
      </a>
    </div>

    <!-- Intro Header -->
    <div class="reveal">
      <div class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
        Personal Sandbox &amp; Experiments
      </div>
      <h1 class="mt-4 text-3xl sm:text-4xl font-semibold tracking-tight text-ink md:text-5xl">
        The Lab — things I build for fun
      </h1>
      <p class="mt-4 max-w-2xl text-sm sm:text-base leading-6 sm:leading-7 text-muted">
        Outside of enterprise architecture and production client work, I explore AI-assisted workflows, interactive web applications, math engines, games, and cultural archives. Everything here is built for curiosity, utility, and joy.
      </p>
    </div>

    <!-- Project Grid (7 Projects) -->
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {aiProjects.map((project) => (
        <a
          href={project.href}
          class="work-card reveal group flex flex-col justify-between hover:border-accent transition-all duration-200"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="text-3xl p-2 rounded-lg bg-surface-alt/70 group-hover:scale-110 transition-transform">
                {project.emoji}
              </span>
              <span class="live-pill font-mono text-[10px] text-muted group-hover:text-accent group-hover:border-accent/40">
                {project.category}
              </span>
            </div>
            <h2 class="mt-4 text-lg font-semibold tracking-tight text-ink group-hover:text-accent transition-colors flex items-center gap-1.5">
              {project.name}
              <svg class="h-4 w-4 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </h2>
            <p class="mt-2 text-xs sm:text-sm text-muted leading-relaxed">
              {project.description}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-line/60 flex items-center justify-between text-xs font-mono text-muted">
            <span>Explore platform</span>
            <span class="text-accent font-semibold">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</PortfolioLayout>
