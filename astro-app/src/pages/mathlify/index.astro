---
import MathlifyLayout from '../../layouts/MathlifyLayout.astro';
import MathlifySearch from '../../components/mathlify/islands/MathlifySearch';
import StandardCalcIsland from '../../components/mathlify/islands/StandardCalcIsland';
import { CALCULATORS } from '../../data/mathlify/calculators';
import { CATEGORIES } from '../../data/mathlify/categories';

const title = 'Mathlify — Simplifying Everyday Math | Free Online Calculators';
const description = 'Mathlify offers free, fast, and accurate online calculators — standard, scientific, BMI, age, percentage, mortgage and more. No ads, no sign-up. 100% client-side privacy.';
const keywords = 'online calculator, scientific calculator, BMI calculator, age calculator, mortgage calculator, percentage calculator, free calculators';
const canonicalUrl = 'https://sayandeepmajumdar.github.io/mathlify/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'Mathlify',
  'url': canonicalUrl,
  'description': 'Free, fast, and accurate online calculators for everyday math, finance, health, and science.',
  'potentialAction': {
    '@type': 'SearchAction',
    'target': 'https://sayandeepmajumdar.github.io/mathlify/#/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<MathlifyLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="page-enter">
    <!-- Hero Section -->
    <section class="hero" style="text-align:center;padding:3.5rem 1rem 2.5rem;background:linear-gradient(180deg, var(--color-accent-light) 0%, transparent 100%);">
      <div class="container" style="max-width:800px;margin:0 auto;">
        <div class="hero__eyebrow" style="display:inline-block;font-size:0.85rem;font-weight:700;color:var(--color-accent);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.75rem;padding:4px 12px;border-radius:20px;background:var(--color-surface);border:1px solid var(--color-border);">
          ✦ 35+ Free Calculators
        </div>
        <h1 class="hero__title" style="font-size:2.75rem;font-weight:800;letter-spacing:-0.03em;line-height:1.15;margin-bottom:1rem;color:var(--color-text);">
          Simplifying Everyday Math
        </h1>
        <p class="hero__subtitle" style="font-size:1.15rem;color:var(--color-text-muted);line-height:1.6;margin-bottom:2rem;max-width:600px;margin-left:auto;margin-right:auto;">
          Fast, accurate, and beautifully designed tools for everyday calculations.
          No ads clutter, no sign-up required. 100% client-side privacy.
        </p>

        <!-- Search Island -->
        <MathlifySearch client:load calculators={CALCULATORS} />
      </div>
    </section>

    <!-- Main Content Grid -->
    <section class="main-content" style="padding:2.5rem 1rem 4rem;">
      <div class="container" style="max-width:1100px;margin:0 auto;">
        <div class="home-grid" style="display:grid;grid-template-columns:360px 1fr;gap:2.5rem;align-items:start;">

          <!-- Standard Calculator featured island -->
          <div>
            <h2 class="section-title" style="font-size:1.25rem;font-weight:700;margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;">
              <span>🧮</span> Quick Calculator
            </h2>
            <div class="calc-panel" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-card);padding:1.25rem;box-shadow:var(--shadow-card);">
              <StandardCalcIsland client:load />
            </div>

            <!-- Value propositions -->
            <div style="margin-top:1.5rem;display:flex;flex-direction:column;gap:0.75rem;">
              <div class="card" style="padding:1rem;display:flex;align-items:center;gap:0.75rem;border-radius:12px;">
                <span style="font-size:1.5rem;">⚡</span>
                <div>
                  <div style="font-weight:600;font-size:0.9rem;">100% Client-Side</div>
                  <div style="font-size:0.8rem;color:var(--color-text-muted);">Zero server latency, your data never leaves device.</div>
                </div>
              </div>
              <div class="card" style="padding:1rem;display:flex;align-items:center;gap:0.75rem;border-radius:12px;">
                <span style="font-size:1.5rem;">🔒</span>
                <div>
                  <div style="font-weight:600;font-size:0.9rem;">No Ads or Sign-Up</div>
                  <div style="font-size:0.8rem;color:var(--color-text-muted);">Pure clean utility designed for focus and speed.</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Browse Categories Grid -->
          <div>
            <h2 class="section-title" style="font-size:1.25rem;font-weight:700;margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;">
              <span>📂</span> Browse All Calculators
            </h2>
            <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(300px, 1fr));gap:1rem;">

              <div class="card" style="cursor:default;padding:1.25rem;border-radius:var(--radius-card);">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;">
                  <span class="card__icon" style="font-size:1.5rem;">💰</span>
                  <div class="card__title" style="font-size:1.1rem;font-weight:700;">Financial</div>
                </div>
                <div class="card__links" style="display:flex;flex-direction:column;gap:0.4rem;">
                  <a class="card__link" href="/mathlify/tools/mortgage-calculator/">Mortgage Calculator</a>
                  <a class="card__link" href="/mathlify/tools/amortization-calculator/">Amortization Calculator</a>
                </div>
              </div>

              <div class="card" style="cursor:default;padding:1.25rem;border-radius:var(--radius-card);">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;">
                  <span class="card__icon" style="font-size:1.5rem;">🏃</span>
                  <div class="card__title" style="font-size:1.1rem;font-weight:700;">Health &amp; Fitness</div>
                </div>
                <div class="card__links" style="display:flex;flex-direction:column;gap:0.4rem;">
                  <a class="card__link" href="/mathlify/tools/bmi-calculator/">BMI Calculator</a>
                  <a class="card__link" href="/mathlify/tools/age-calculator/">Age Calculator</a>
                  <a class="card__link" href="/mathlify/tools/calorie-calculator/">Calorie &amp; Macro Calculator</a>
                </div>
              </div>

              <div class="card" style="cursor:default;padding:1.25rem;border-radius:var(--radius-card);">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;">
                  <span class="card__icon" style="font-size:1.5rem;">📐</span>
                  <div class="card__title" style="font-size:1.1rem;font-weight:700;">Math &amp; Algebra</div>
                </div>
                <div class="card__links" style="display:flex;flex-direction:column;gap:0.4rem;">
                  <a class="card__link" href="/mathlify/tools/time-calculator/">Time Calculator</a>
                  <a class="card__link" href="/mathlify/tools/scientific-calculator/">Scientific Calculator</a>
                  <a class="card__link" href="/mathlify/tools/percentage-calculator/">Percentage Calculator</a>
                  <a class="card__link" href="/mathlify/tools/exponent-calculator/">Exponent Calculator</a>
                  <a class="card__link" href="/mathlify/tools/root-calculator/">Root Calculator</a>
                  <a class="card__link" href="/mathlify/tools/log-calculator/">Log Calculator</a>
                  <a class="card__link" href="/mathlify/tools/quadratic-calculator/">Quadratic Formula</a>
                  <a class="card__link" href="/mathlify/tools/random-calculator/">Random Number Generator</a>
                  <a class="card__link" href="/mathlify/tools/scientific-notation-calculator/">Scientific Notation</a>
                  <a class="card__link" href="/mathlify/tools/big-number-calculator/">Big Number Calculator</a>
                </div>
              </div>

              <div class="card" style="cursor:default;padding:1.25rem;border-radius:var(--radius-card);">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;">
                  <span class="card__icon" style="font-size:1.5rem;">📐</span>
                  <div class="card__title" style="font-size:1.1rem;font-weight:700;">Geometry &amp; 3D</div>
                </div>
                <div class="card__links" style="display:flex;flex-direction:column;gap:0.4rem;">
                  <a class="card__link" href="/mathlify/tools/triangle-calculator/">Triangle Calculator</a>
                  <a class="card__link" href="/mathlify/tools/volume-calculator/">Volume Calculator</a>
                  <a class="card__link" href="/mathlify/tools/slope-calculator/">Slope Calculator</a>
                  <a class="card__link" href="/mathlify/tools/area-calculator/">Area Calculator</a>
                  <a class="card__link" href="/mathlify/tools/distance-calculator/">Distance Calculator</a>
                  <a class="card__link" href="/mathlify/tools/circle-calculator/">Circle Calculator</a>
                  <a class="card__link" href="/mathlify/tools/surface-area-calculator/">Surface Area Calculator</a>
                  <a class="card__link" href="/mathlify/tools/pythagorean-calculator/">Pythagorean Theorem</a>
                  <a class="card__link" href="/mathlify/tools/right-triangle-calculator/">Right Triangle Calculator</a>
                </div>
              </div>

              <div class="card" style="cursor:default;padding:1.25rem;border-radius:var(--radius-card);">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;">
                  <span class="card__icon" style="font-size:1.5rem;">🔢</span>
                  <div class="card__title" style="font-size:1.1rem;font-weight:700;">Number Theory</div>
                </div>
                <div class="card__links" style="display:flex;flex-direction:column;gap:0.4rem;">
                  <a class="card__link" href="/mathlify/tools/factor-calculator/">Factor Calculator</a>
                  <a class="card__link" href="/mathlify/tools/lcm-calculator/">LCM Calculator</a>
                  <a class="card__link" href="/mathlify/tools/gcf-calculator/">GCF Calculator</a>
                  <a class="card__link" href="/mathlify/tools/ratio-calculator/">Ratio Calculator</a>
                </div>
              </div>

              <div class="card" style="cursor:default;padding:1.25rem;border-radius:var(--radius-card);">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;">
                  <span class="card__icon" style="font-size:1.5rem;">💻</span>
                  <div class="card__title" style="font-size:1.1rem;font-weight:700;">Base Conversion</div>
                </div>
                <div class="card__links" style="display:flex;flex-direction:column;gap:0.4rem;">
                  <a class="card__link" href="/mathlify/tools/binary-calculator/">Binary Calculator</a>
                  <a class="card__link" href="/mathlify/tools/hex-calculator/">Hex Calculator</a>
                </div>
              </div>

              <div class="card" style="cursor:default;padding:1.25rem;border-radius:var(--radius-card);">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;">
                  <span class="card__icon" style="font-size:1.5rem;">🧪</span>
                  <div class="card__title" style="font-size:1.1rem;font-weight:700;">Science &amp; Physics</div>
                </div>
                <div class="card__links" style="display:flex;flex-direction:column;gap:0.4rem;">
                  <a class="card__link" href="/mathlify/tools/percent-error-calculator/">Percent Error</a>
                  <a class="card__link" href="/mathlify/tools/half-life-calculator/">Half-Life Calculator</a>
                </div>
              </div>

              <div class="card" style="cursor:default;padding:1.25rem;border-radius:var(--radius-card);">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;">
                  <span class="card__icon" style="font-size:1.5rem;">📊</span>
                  <div class="card__title" style="font-size:1.1rem;font-weight:700;">Advanced</div>
                </div>
                <div class="card__links" style="display:flex;flex-direction:column;gap:0.4rem;">
                  <a class="card__link" href="/mathlify/tools/matrix-calculator/">Matrix Calculator</a>
                  <a class="card__link" href="/mathlify/tools/round-calculator/">Rounding Calculator</a>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>
  </div>
</MathlifyLayout>
