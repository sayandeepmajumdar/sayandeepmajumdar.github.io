---
import VigyanLayout from '../../layouts/VigyanLayout.astro';
import Navbar from '../../components/vigyan/Navbar.astro';
import Footer from '../../components/vigyan/Footer.astro';
import { InteractiveVigyanTimeline } from '../../components/vigyan/InteractiveVigyanTimeline';
import { DISCOVERIES } from '../../data/vigyan/discoveries';
import { ALL_FIELDS } from '../../data/vigyan/fields';

const totalDiscoveries = DISCOVERIES.length;
const totalFields = ALL_FIELDS.length;
---

<VigyanLayout
  title="VIGYAN — Science & Discoveries Timeline | History of Human Knowledge"
  description="Explore 500+ years of breakthrough scientific discoveries, from the heliocentric cosmos to mRNA vaccines. Interactive continuous timeline with live search and plain-language stories for all ages."
  canonicalUrl="https://sayandeepmajumdar.github.io/vigyan/"
>
  <Navbar slot="header" />

  <div class="w-full pb-24">
    {/* Hero Intro Header */}
    <section class="relative overflow-hidden py-14 sm:py-20 border-b border-white/10 bg-gradient-to-b from-[#0c101c] via-[#080c16] to-[#06080e]">
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[580px] h-[300px] rounded-full blur-[140px] pointer-events-none opacity-25 bg-gradient-to-r from-sky-500 via-teal-400 to-emerald-500"
        aria-hidden="true"
      ></div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-5 relative z-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-sky-500/30 bg-sky-500/10 text-sky-300 text-xs font-semibold uppercase tracking-widest shadow-sm">
          <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
          <span>Discoveries That Changed Everything</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-display tracking-tight text-white leading-tight">
          Science &amp; Discoveries{' '}
          <span class="bg-gradient-to-r from-sky-400 via-teal-300 to-emerald-300 bg-clip-text text-transparent">
            Timeline
          </span>
        </h1>

        <p class="text-stone-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto font-normal">
          From the realization that Earth orbits the Sun to penicillin, DNA, and gravitational waves—explore the giant leaps in human curiosity on one easy-to-read, continuous timeline.
        </p>

        {/* Quick Stats Badges */}
        <div class="pt-3 flex items-center justify-center gap-3 sm:gap-6 flex-wrap text-xs font-mono text-stone-300">
          <div class="px-3.5 py-1.5 rounded-xl bg-white/5 border border-white/10 flex items-center gap-2 shadow-sm">
            <span class="text-sky-400 font-bold text-sm">{totalDiscoveries}</span>
            <span>Breakthroughs</span>
          </div>
          <div class="px-3.5 py-1.5 rounded-xl bg-white/5 border border-white/10 flex items-center gap-2 shadow-sm">
            <span class="text-teal-400 font-bold text-sm">{totalFields}</span>
            <span>Disciplines</span>
          </div>
          <div class="px-3.5 py-1.5 rounded-xl bg-white/5 border border-white/10 flex items-center gap-2 shadow-sm">
            <span class="text-emerald-400 font-bold text-sm">500+</span>
            <span>Years of Progress</span>
          </div>
        </div>
      </div>
    </section>

    {/* Main Continuous Timeline Content */}
    <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14">
      <InteractiveVigyanTimeline client:idle discoveries={DISCOVERIES} />
    </div>
  </div>

  <Footer slot="footer" />
</VigyanLayout>
