---
interface Props {
  currentPath?: string;
}

const { currentPath = '/tools/' } = Astro.props;
---

<header class="sticky top-0 z-50 bg-surface/90 backdrop-blur-md border-b border-line transition-colors">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-2 sm:gap-4">
    {/* Brand */}
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a
        href="/tools/"
        class="flex items-center gap-2.5 text-ink hover:opacity-95 transition-opacity focus:outline-none select-none"
        aria-label="Toolzy Platform Home"
      >
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl relative flex items-center justify-center p-0.5 shadow-md shrink-0 bg-surface border border-line overflow-hidden">
          <div class="absolute inset-0 grid grid-cols-2 grid-rows-2 opacity-20 dark:opacity-30">
            <div class="bg-[#4285F4]"></div>
            <div class="bg-[#EA4335]"></div>
            <div class="bg-[#FBBC05]"></div>
            <div class="bg-[#34A853]"></div>
          </div>
          <svg
            class="w-4/6 h-4/6 relative z-10 drop-shadow-xs"
            viewBox="0 0 24 24"
            fill="none"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" class="stroke-[#4285F4] dark:stroke-[#60a5fa]"></path>
            <circle cx="18" cy="6" r="1.5" class="fill-[#EA4335]"></circle>
            <circle cx="6" cy="18" r="1.5" class="fill-[#34A853]"></circle>
          </svg>
        </div>
        <span class="text-base sm:text-lg font-extrabold tracking-tight inline-flex font-sans">
          <span class="text-[#4285F4] dark:text-[#5B95F5] transition-colors">T</span>
          <span class="text-[#EA4335] dark:text-[#F06A5D] transition-colors">o</span>
          <span class="text-[#FBBC05] dark:text-[#FCD04B] transition-colors">o</span>
          <span class="text-[#4285F4] dark:text-[#5B95F5] transition-colors">l</span>
          <span class="text-[#34A853] dark:text-[#57B972] transition-colors">z</span>
          <span class="text-[#EA4335] dark:text-[#F06A5D] transition-colors">y</span>
        </span>
        <span class="text-[10px] font-mono font-bold uppercase px-1.5 py-0.5 rounded-full bg-surface-alt border border-line text-muted hidden md:inline-block">
          v1.0
        </span>
      </a>
    </div>

    {/* Center Navigation Links / Breadcrumbs */}
    <nav class="hidden md:flex items-center gap-1 text-xs font-semibold text-muted" aria-label="Quick Section Links">
      <a href="/tools/" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath === '/tools/' ? 'text-ink bg-surface-alt font-bold' : 'hover:text-ink hover:bg-surface-alt'}`}>
        Catalog
      </a>
      <a href="/tools/developer/" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/tools/developer') ? 'text-ink bg-surface-alt font-bold' : 'hover:text-ink hover:bg-surface-alt'}`}>
        Developer
      </a>
      <a href="/tools/security/" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/tools/security') ? 'text-ink bg-surface-alt font-bold' : 'hover:text-ink hover:bg-surface-alt'}`}>
        Security
      </a>
      <a href="/tools/design/" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/tools/design') ? 'text-ink bg-surface-alt font-bold' : 'hover:text-ink hover:bg-surface-alt'}`}>
        Design
      </a>
      <a href="/tools/data/" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/tools/data') ? 'text-ink bg-surface-alt font-bold' : 'hover:text-ink hover:bg-surface-alt'}`}>
        Data
      </a>
    </nav>

    {/* Right Actions */}
    <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
      {/* Request New Tool */}
      <a
        href="mailto:developerslab101@gmail.com?subject=New%20Tool%20Request%20-%20Toolzy&body=Hi%20Toolzy%20Team%2C%0A%0AI%20would%20like%20to%20request%20a%20new%20tool%20for%20Toolzy%3A%0A%0A-%20Tool%20Name%3A%20%0A-%20Description%20%26%20Use%20Case%3A%20%0A-%20Key%20Features%3A%20%0A%0AThank%20you!"
        class="hidden lg:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-accent hover:text-white hover:bg-accent border border-accent/30 transition-all shadow-2xs"
        title="Request for adding a new tool"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>Request Tool</span>
      </a>

      {/* Starred link */}
      <a
        href="/tools/?tab=favorites"
        class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-muted hover:text-ink hover:bg-surface-alt transition-colors"
        title="Starred Favorites"
      >
        <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span>Starred</span>
      </a>

      {/* Theme Toggle Button */}
      <button
        type="button"
        id="theme-toggle"
        class="p-2 rounded-xl text-muted hover:text-ink hover:bg-surface-alt border border-line transition-all cursor-pointer"
        title="Toggle Light/Dark Theme"
        aria-label="Toggle theme"
      >
        <svg id="theme-icon-sun" class="w-4 h-4 text-amber-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <svg id="theme-icon-moon" class="w-4 h-4 text-indigo-500 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>

      {/* Portfolio Backlink */}
      <a
        href="/"
        class="inline-flex items-center gap-1 px-2.5 sm:px-3 py-1.5 rounded-lg text-xs font-semibold text-muted hover:text-ink hover:bg-surface-alt border border-line transition-all"
        title="Return to Main Portfolio"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span class="hidden sm:inline">Portfolio</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    function updateThemeIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      const sun = document.getElementById('theme-icon-sun');
      const moon = document.getElementById('theme-icon-moon');
      if (sun && moon) {
        if (isDark) {
          sun.classList.remove('hidden');
          sun.classList.add('block');
          moon.classList.remove('block');
          moon.classList.add('hidden');
        } else {
          sun.classList.remove('block');
          sun.classList.add('hidden');
          moon.classList.remove('hidden');
          moon.classList.add('block');
        }
      }
    }

    updateThemeIcons();

    const btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', function() {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('toolbox:theme', isDark ? 'dark' : 'light');
          localStorage.setItem('theme-mode', isDark ? 'dark' : 'light');
          window.dispatchEvent(new CustomEvent('toolbox:theme-updated', { detail: isDark ? 'dark' : 'light' }));
        } catch (e) {}
        updateThemeIcons();
      });
    }
  })();
</script>
