---
import { CATEGORIES } from '../../data/tools/categories';
---

<footer class="border-t border-line bg-surface mt-auto py-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      {/* Brand & Privacy Statement */}
      <div class="md:col-span-2 flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg relative flex items-center justify-center p-0.5 shadow-xs shrink-0 bg-surface border border-line overflow-hidden">
            <div class="absolute inset-0 grid grid-cols-2 grid-rows-2 opacity-20 dark:opacity-30">
              <div class="bg-[#4285F4]"></div>
              <div class="bg-[#EA4335]"></div>
              <div class="bg-[#FBBC05]"></div>
              <div class="bg-[#34A853]"></div>
            </div>
            <svg
              class="w-4/6 h-4/6 relative z-10"
              viewBox="0 0 24 24"
              fill="none"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" class="stroke-[#4285F4] dark:stroke-[#60a5fa]"></path>
              <circle cx="18" cy="6" r="1.5" class="fill-[#EA4335]"></circle>
              <circle cx="6" cy="18" r="1.5" class="fill-[#34A853]"></circle>
            </svg>
          </div>
          <span class="text-base font-extrabold tracking-tight inline-flex font-sans">
            <span class="text-[#4285F4] dark:text-[#5B95F5]">T</span>
            <span class="text-[#EA4335] dark:text-[#F06A5D]">o</span>
            <span class="text-[#FBBC05] dark:text-[#FCD04B]">o</span>
            <span class="text-[#4285F4] dark:text-[#5B95F5]">l</span>
            <span class="text-[#34A853] dark:text-[#57B972]">z</span>
            <span class="text-[#EA4335] dark:text-[#F06A5D]">y</span>
          </span>
          <span class="text-xs text-muted font-medium">by sayandeep.dev</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            100% Client-Side
          </span>
        </div>
        <p class="text-xs text-muted leading-relaxed max-w-md">
          A private, high-performance developer tools platform built with modern web standards and Astro SSG.
          All crypto algorithms, text formatters, image minifiers, and file exports run entirely inside your browser. No cookies, no tracking, zero telemetry.
        </p>
        <div class="flex flex-wrap items-center gap-3 mt-2 text-xs text-muted">
          <a
            href="mailto:developerslab101@gmail.com?subject=New%20Tool%20Request%20-%20Toolzy&body=Hi%20Toolzy%20Team%2C%0A%0AI%20would%20like%20to%20request%20a%20new%20tool%20for%20Toolzy%3A%0A%0A-%20Tool%20Name%3A%20%0A-%20Description%20%26%20Use%20Case%3A%20%0A-%20Key%20Features%3A%20%0A%0AThank%20you!"
            class="inline-flex items-center gap-1.5 text-accent hover:underline font-semibold transition-colors"
            title="Send tool request email to developerslab101@gmail.com"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span>Request a Tool</span>
          </a>
          <span>•</span>
          <a
            href="https://github.com/sayandeepmajumdar"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 hover:text-ink transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            <span>GitHub</span>
          </a>
          <span>•</span>
          <a
            href="/"
            class="inline-flex items-center gap-1 hover:text-ink transition-colors"
          >
            <span>Portfolio</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </a>
          <span>•</span>
          <a href="/rasoi/" class="hover:text-ink transition-colors">Rasoi</a>
          <span>•</span>
          <a href="/yatra/" class="hover:text-ink transition-colors">Yatra</a>
          <span>•</span>
          <a href="/itihaas/" class="hover:text-ink transition-colors">Itihaas</a>
          <span>•</span>
          <a href="/vigyan/" class="hover:text-ink transition-colors">Vigyan</a>
        </div>
      </div>

      {/* Categories Column 1 */}
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-ink mb-3 font-mono">
          Categories
        </h4>
        <ul class="flex flex-col gap-2 text-xs text-muted">
          {CATEGORIES.slice(0, 6).map((cat) => (
            <li>
              <a
                href={`/tools/${cat.slug}/`}
                class="hover:text-accent transition-colors"
              >
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Categories Column 2 */}
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-ink mb-3 font-mono">
          More Tools
        </h4>
        <ul class="flex flex-col gap-2 text-xs text-muted">
          {CATEGORIES.slice(6).map((cat) => (
            <li>
              <a
                href={`/tools/${cat.slug}/`}
                class="hover:text-accent transition-colors"
              >
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t border-line/60 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-muted">
      <p>© 2026 sayandeep.dev • Built with Astro SSG, React &amp; Tailwind</p>
      <div class="flex items-center gap-1.5 text-xs text-muted">
        <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
        <span>Zero server requests • 100% in-browser processing</span>
      </div>
    </div>
  </div>
</footer>
