---
import { personalInfo } from '../../data/portfolio/profile';
---

<section id="about" class="site-section border-t border-line">
  <div class="reveal">
    <p class="section-label">About</p>
    <h2 class="section-heading">The developer</h2>
    <div class="mt-6 space-y-4 max-w-2xl leading-7 text-muted">
      {personalInfo.bioParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>
</section>
