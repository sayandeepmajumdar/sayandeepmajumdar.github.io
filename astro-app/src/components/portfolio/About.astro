---
import { personalInfo, educationAndCommunity } from '../../data/portfolio/profile';
---

<section id="about" class="site-section border-t border-line">
  <div class="reveal">
    <p class="section-label">About</p>
    <h2 class="section-heading">The developer</h2>
    <div class="mt-6 space-y-4 max-w-2xl leading-7 text-muted text-sm sm:text-base">
      {personalInfo.bioParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>

  <div class="mt-12 pt-10 border-t border-line/60">
    <div class="reveal">
      <p class="section-label">Education + Community</p>
      <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-ink mt-2">Background</h3>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {educationAndCommunity.map((item) => (
        <article class="mini-card reveal">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
