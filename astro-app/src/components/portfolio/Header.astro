---
import { aiProjects, personalInfo } from '../../data/portfolio/profile';
---

<header class="sticky top-0 z-50 border-b backdrop-blur" style="border-color: rgb(var(--color-line)); background-color: rgb(var(--color-bg) / 0.85);">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-4 sm:px-6 py-4" aria-label="Primary navigation">
    <a href="#top" class="font-mono text-sm font-semibold tracking-tight transition-colors hover:text-accent" style="color: rgb(var(--color-text));" aria-label="Sayandeep Majumdar home">
      sayandeep.dev
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden items-center gap-1 md:flex">
      <a href="#work" class="nav-link">Work</a>
      <a href="#about" class="nav-link">About</a>
      <a href="#stack" class="nav-link">Stack</a>

      <!-- Made with AI Dropdown -->
      <div class="relative group" id="ai-dropdown-wrapper">
        <button
          id="ai-menu-btn"
          type="button"
          class="nav-link inline-flex items-center gap-1.5 focus:outline-none cursor-pointer"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Made with AI</span>
          <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id="ai-menu-panel"
          class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-150 absolute left-0 mt-1 w-56 rounded-xl border shadow-xl p-1.5 z-50 backdrop-blur"
          style="border-color: rgb(var(--color-line)); background-color: rgb(var(--color-surface) / 0.96);"
          role="menu"
          aria-labelledby="ai-menu-btn"
        >
          {aiProjects.map((project) => (
            <a
              href={project.href}
              class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-ink hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              role="menuitem"
            >
              <span class="text-base">{project.emoji}</span>
              <div>
                <span class="font-medium block leading-tight">{project.name}</span>
                <span class="text-[11px] text-muted block">{project.category}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <a href="#contact" class="nav-link">Contact</a>
    </div>

    <!-- Actions & Mobile Button -->
    <div class="flex items-center gap-2">
      <!-- Dark Mode Toggle Button -->
      <button
        id="theme-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-md border border-line p-2 text-ink transition-colors hover:border-accent hover:text-accent cursor-pointer"
        aria-label="Toggle dark mode"
      >
        <svg class="h-4 w-4 hidden dark:block" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/>
        </svg>
        <svg class="h-4 w-4 block dark:hidden" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
        </svg>
      </button>

      <a
        href={`mailto:${personalInfo.email}`}
        class="hidden rounded-md border border-line px-3 py-1.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent md:inline-flex"
      >
        Get in touch
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button
        id="menu-toggle"
        type="button"
        class="rounded-md border border-line px-3 py-1.5 text-sm font-medium text-ink md:hidden cursor-pointer"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        Menu
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden border-t px-6 py-4 md:hidden space-y-2" style="border-color: rgb(var(--color-line));">
    <a href="#work" class="nav-link block py-1.5">Work</a>
    <a href="#about" class="nav-link block py-1.5">About</a>
    <a href="#stack" class="nav-link block py-1.5">Stack</a>

    <div class="pt-2 pb-2 border-t" style="border-color: rgb(var(--color-line) / 0.5);">
      <div class="text-[11px] font-mono font-bold uppercase tracking-wider text-accent px-3 pb-1">
        Made with AI
      </div>
      <div class="pl-2 space-y-1 border-l-2 ml-3 my-1" style="border-color: rgb(var(--color-line));">
        {aiProjects.map((project) => (
          <a href={project.href} class="nav-link block text-sm py-1">
            {project.emoji} {project.name}
          </a>
        ))}
      </div>
    </div>

    <a href="#contact" class="nav-link block py-1.5">Contact</a>
    <div class="pt-2">
      <a
        href={`mailto:${personalInfo.email}`}
        class="block text-center rounded-md border border-line px-3 py-2 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
      >
        Get in touch
      </a>
    </div>
  </div>
</header>
