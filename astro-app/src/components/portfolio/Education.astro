---
import { educationAndCommunity } from '../../data/portfolio/profile';
---

<section class="site-section border-t border-line">
  <div class="reveal">
    <p class="section-label">Education + Community</p>
    <h2 class="section-heading">Background</h2>
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {educationAndCommunity.map((item) => (
      <article class="mini-card reveal">
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </article>
    ))}
  </div>
</section>
