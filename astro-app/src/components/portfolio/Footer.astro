<footer class="mx-auto flex max-w-4xl flex-col gap-3 border-t border-line px-4 sm:px-6 py-8 text-sm text-muted md:flex-row md:items-center md:justify-between">
  <p>
    © 2026 {personalInfo.name} · Powered by{' '}
    <a
      href="https://github.com/sayandeepmajumdar"
      target="_blank"
      rel="noopener noreferrer"
      class="font-medium text-ink hover:text-accent transition-colors"
    >
      DevelopersLab101
    </a>{' '}
    &amp;{' '}
    <a href="/" class="font-medium text-ink hover:text-accent transition-colors">
      sayandeep.dev
    </a>
  </p>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-medium">
    <a href="/lab/" class="transition-colors hover:text-ink font-semibold text-accent">Lab →</a>
    <a href="/resume/" class="transition-colors hover:text-ink">📄 Resume</a>
    <a href="/sitemap.xml" class="transition-colors hover:text-ink">Sitemap</a>
