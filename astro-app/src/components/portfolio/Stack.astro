---
import { techSkills, engineeringPillars } from '../../data/portfolio/profile';
---

<section id="stack" class="site-section border-t border-line">
  <div class="reveal">
    <p class="section-label">Tech Stack</p>
    <h2 class="section-heading">Tools I work with</h2>
    <div class="stack-cloud">
      {techSkills.map((skill) => (
        <span>{skill}</span>
      ))}
    </div>
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-4">
    {engineeringPillars.map((pillar) => (
      <article class="mini-card reveal">
        <h3>{pillar.title}</h3>
        <p>{pillar.description}</p>
      </article>
    ))}
  </div>
</section>
