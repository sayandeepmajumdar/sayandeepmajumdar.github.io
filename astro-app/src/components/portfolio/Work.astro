---
import { workExperiences } from '../../data/portfolio/profile';
---

<section id="work" class="site-section border-t border-line">
  <div class="reveal">
    <p class="section-label">Production Engineering</p>
    <h2 class="section-heading">Real work</h2>
    <p class="section-intro">
      Production systems, CMS platforms, integrations, and search-ready infrastructure built for real users and business outcomes.
    </p>
  </div>

  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {workExperiences.map((w) => (
      <article class="work-card reveal">
        <div class="flex items-center justify-between gap-3">
          <span class="live-pill">{w.pill}</span>
          <span class="font-mono text-xs text-muted">{w.role}</span>
        </div>
        <h3>{w.title}</h3>
        <p>{w.description}</p>
        <div class="tag-row">
          {w.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
