---
import { contacts } from '../../data/portfolio/profile';
---

<section id="contact" class="site-section border-t border-line">
  <div class="reveal">
    <p class="section-label">Start a Project</p>
    <h2 class="section-heading">Let's build</h2>
    <p class="section-intro">
      Open to senior software engineering, Laravel/WordPress development, technical SEO, performance optimisation, and cloud-backed web platform work.
    </p>
  </div>

  <div class="contact-panel mt-8 max-w-xl reveal">
    {contacts.map((contact) => (
      <a
        href={contact.href}
        target={contact.external ? '_blank' : undefined}
        rel={contact.external ? 'noopener noreferrer' : undefined}
      >
        {contact.label}
        <span>{contact.value}</span>
      </a>
    ))}
  </div>
</section>
