---
import type { Recipe } from '../../types/rasoi';

interface Props {
  recipe: Recipe;
  priority?: boolean;
}

const { recipe, priority = false } = Astro.props;
const isVeg = recipe.diet.includes('Vegetarian') || recipe.diet.includes('Vegan');

const getDifficultyClass = (diff: string) => {
  switch (diff) {
    case 'Easy':
      return 'text-emerald-700 bg-emerald-50 border-emerald-200';
    case 'Medium':
      return 'text-amber-700 bg-amber-50 border-amber-200';
    case 'Hard':
      return 'text-rose-700 bg-rose-50 border-rose-200';
    default:
      return 'text-stone-700 bg-stone-50 border-stone-200';
  }
};
---

<article class="group relative bg-white rounded-2xl border border-stone-200/90 overflow-hidden shadow-2xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col select-none">
  <a
    href={`/rasoi/recipe/${recipe.slug}/`}
    class="flex-1 flex flex-col h-full text-inherit no-underline"
  >
    {/* Food Image Container */}
    <div class="relative aspect-[4/3] w-full overflow-hidden bg-stone-100">
      <img
        src={recipe.image}
        alt={recipe.name}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
        loading={priority ? undefined : "lazy"}
        fetchpriority={priority ? "high" : undefined}
      />

      {/* Subtle Dark Gradient Overlay for Badges */}
      <div class="absolute inset-0 bg-gradient-to-t from-stone-900/60 via-transparent to-black/20 pointer-events-none"></div>

      {/* Top Badges: Region + Veg/Non-Veg */}
      <div class="absolute top-3 left-3 flex items-center gap-2">
        <div
          class={`w-6 h-6 rounded-md bg-white/95 backdrop-blur-xs flex items-center justify-center border shadow-2xs ${
            isVeg ? 'border-emerald-600' : 'border-rose-700'
          }`}
          title={isVeg ? 'Vegetarian' : 'Non-Vegetarian'}
        >
          <span
            class={`w-2.5 h-2.5 rounded-full ${
              isVeg ? 'bg-emerald-600' : 'bg-rose-700'
            }`}
          ></span>
        </div>

        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-stone-900/80 text-amber-300 backdrop-blur-md shadow-2xs border border-white/10">
          {recipe.region}
        </span>
      </div>

      {/* Bottom Image Bar: Category & Total Time */}
      <div class="absolute bottom-2.5 left-3 right-3 flex items-center justify-between text-white text-xs font-medium">
        <span class="bg-stone-900/70 backdrop-blur-md px-2 py-0.5 rounded-md border border-white/10 text-stone-200">
          {recipe.category}
        </span>
        <div class="flex items-center gap-1 bg-stone-900/70 backdrop-blur-md px-2 py-0.5 rounded-md border border-white/10 text-amber-300 font-semibold">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{recipe.totalTime} min</span>
        </div>
      </div>
    </div>

    {/* Card Content Body */}
    <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between">
      <div>
        {/* Rating and Spice Level */}
        <div class="flex items-center justify-between mb-1.5">
          <div class="flex items-center gap-1 text-amber-500">
            <svg class="w-4 h-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <span class="text-xs font-bold text-stone-900">{recipe.rating.toFixed(1)}</span>
            <span class="text-[11px] text-stone-400 font-normal">
              ({recipe.ratingCount.toLocaleString()})
            </span>
          </div>

          <div class="flex items-center gap-1 text-xs font-semibold">
            <span
              class={`text-[11px] ${
                recipe.spiceLevel === 'Spicy'
                  ? 'text-rose-700 font-bold'
                  : recipe.spiceLevel === 'Medium'
                  ? 'text-amber-800'
                  : 'text-stone-500'
              }`}
            >
              🌶️ {recipe.spiceLevel}
            </span>
          </div>
        </div>

        {/* Recipe Name */}
        <h3 class="font-serif font-bold text-base sm:text-lg text-stone-900 group-hover:text-rose-900 transition-colors line-clamp-1 leading-snug">
          {recipe.name}
        </h3>

        {/* Description snippet */}
        <p class="mt-1 text-xs text-stone-600 line-clamp-2 leading-relaxed font-normal">
          {recipe.description}
        </p>
      </div>

      {/* Footer Info */}
      <div class="mt-4 pt-3 border-t border-stone-100 flex items-center justify-between text-xs">
        <span class={`px-2 py-0.5 rounded-md font-semibold border text-[11px] ${getDifficultyClass(recipe.difficulty)}`}>
          {recipe.difficulty}
        </span>
        <span class="text-stone-500 text-[11px] font-semibold group-hover:text-rose-900 transition-colors flex items-center gap-1">
          View Recipe &rarr;
        </span>
      </div>
    </div>
  </a>
</article>
