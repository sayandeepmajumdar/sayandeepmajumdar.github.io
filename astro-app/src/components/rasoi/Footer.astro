---
import { REGIONS } from '../../data/rasoi/recipes';
---

<footer class="bg-stone-900 text-stone-300 border-t border-stone-800 mt-20">
  {/* Top Banner Accent */}
  <div class="h-1.5 w-full bg-gradient-to-r from-rose-700 via-amber-500 to-rose-800"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      {/* Brand & Mission */}
      <div class="lg:col-span-2 space-y-4">
        <a
          href="/rasoi/"
          class="flex items-center gap-3 cursor-pointer group select-none"
        >
          <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-rose-700 to-amber-500 flex items-center justify-center text-xl shadow-md">
            🍛
          </div>
          <span class="text-2xl font-black tracking-tight text-white font-serif">
            Rasoi
          </span>
        </a>
        <p class="text-stone-400 text-sm leading-relaxed max-w-md">
          "Discover authentic Indian recipes, one delicious dish at a time."
        </p>
        <p class="text-stone-400 text-xs leading-relaxed max-w-md">
          From the smoky tandoors of Punjab to the coconut-rich dishes of Kerala, Rasoi brings
          together 50+ time-tested authentic regional dishes with precise measurements and
          realistic culinary techniques.
        </p>
        <div class="flex items-center gap-2 text-xs text-amber-400/90 font-medium pt-1">
          <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>100% Static HTML • Instant Load • Zero Ads • Client-Side Scaler</span>
        </div>
      </div>

      {/* Regional Cuisines */}
      <div class="space-y-3">
        <h3 class="text-white text-sm font-bold tracking-wider uppercase font-serif flex items-center gap-2">
          <span>🥘 Cuisine Regions</span>
        </h3>
        <ul class="space-y-2 text-xs text-stone-400">
          {REGIONS.slice(0, 5).map((region) => (
            <li>
              <a
                href={`/rasoi/explore/?region=${encodeURIComponent(region)}`}
                class="hover:text-amber-400 hover:translate-x-1 transition-all inline-block"
              >
                {region} Recipes
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* More Regions */}
      <div class="space-y-3">
        <h3 class="text-white text-sm font-bold tracking-wider uppercase font-serif">
          More Flavors
        </h3>
        <ul class="space-y-2 text-xs text-stone-400">
          {REGIONS.slice(5).map((region) => (
            <li>
              <a
                href={`/rasoi/explore/?region=${encodeURIComponent(region)}`}
                class="hover:text-amber-400 hover:translate-x-1 transition-all inline-block"
              >
                {region}
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a
              href="/rasoi/explore/"
              class="text-amber-400 hover:underline font-semibold"
            >
              View All 50 Recipes &rarr;
            </a>
          </li>
        </ul>
      </div>

      {/* Quick Links & Cross-Section Links */}
      <div class="space-y-3">
        <h3 class="text-white text-sm font-bold tracking-wider uppercase font-serif">
          Navigation
        </h3>
        <ul class="space-y-2 text-xs text-stone-400">
          <li>
            <a href="/rasoi/" class="hover:text-amber-400 transition-colors block">
              Rasoi Home
            </a>
          </li>
          <li>
            <a href="/rasoi/explore/" class="hover:text-amber-400 transition-colors block">
              Recipe Explorer
            </a>
          </li>
          <li>
            <a href="/rasoi/favorites/" class="hover:text-amber-400 transition-colors block">
              Saved Recipe Box
            </a>
          </li>
          <li>
            <a href="/rasoi/about/" class="hover:text-amber-400 transition-colors block">
              Culinary Heritage &amp; About
            </a>
          </li>
          <li class="pt-2 border-t border-stone-800">
            <a href="/" class="text-stone-400 hover:text-white transition-colors block font-medium">
              &larr; Sayandeep Majumdar Portfolio
            </a>
          </li>
          <li>
            <a href="/vigyan/" class="text-stone-400 hover:text-white transition-colors block">
              Vigyan &mdash; Science Timeline 🔬
            </a>
          </li>
          <li>
            <a href="/itihaas/" class="text-stone-400 hover:text-white transition-colors block">
              Itihaas &mdash; Indian History 🇮🇳
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="mt-12 pt-8 border-t border-stone-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p>&copy; {new Date().getFullYear()} Rasoi &middot; Celebrating India's incredible food culture.</p>
      <div class="flex items-center gap-1">
        <span>Crafted for authentic Indian home cooking</span>
      </div>
    </div>
  </div>
</footer>
