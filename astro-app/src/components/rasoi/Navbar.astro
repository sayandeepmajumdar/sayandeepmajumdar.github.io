---
interface Props {
  currentPath?: string;
}

const pathname = Astro.props.currentPath || Astro.url.pathname;
const isHome = pathname === '/rasoi/' || pathname === '/rasoi';
const isExplore = pathname.startsWith('/rasoi/explore');
const isFavorites = pathname.startsWith('/rasoi/favorites');
const isAbout = pathname.startsWith('/rasoi/about');
---

<header class="sticky top-0 z-40 w-full bg-[#faf7f2]/95 backdrop-blur-md border-b border-stone-200/80 shadow-2xs transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      {/* Brand Logo */}
      <a
        href="/rasoi/"
        class="flex items-center gap-3 cursor-pointer group select-none"
        aria-label="Rasoi Home"
      >
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-rose-900 via-rose-800 to-amber-600 flex items-center justify-center text-2xl shadow-md group-hover:scale-105 transition-transform duration-300">
          🍛
        </div>
        <div>
          <span class="text-2xl font-black tracking-tight text-rose-950 font-serif flex items-center gap-1.5">
            Rasoi
            <span class="inline-block w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
          </span>
          <p class="text-[11px] font-medium tracking-wide uppercase text-stone-500 hidden sm:block">
            Authentic Indian Recipes
          </p>
        </div>
      </a>

      {/* Desktop Navigation Links */}
      <nav class="hidden md:flex items-center gap-1.5 lg:gap-2" aria-label="Main Navigation">
        <a
          href="/rasoi/"
          class={`relative flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200 ${
            isHome
              ? 'bg-rose-900 text-white shadow-sm shadow-rose-950/20'
              : 'text-stone-700 hover:text-rose-900 hover:bg-rose-50/80'
          }`}
        >
          <svg class={`w-4 h-4 ${isHome ? 'text-amber-300' : 'text-stone-500'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Home</span>
        </a>

        <a
          href="/rasoi/explore/"
          class={`relative flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200 ${
            isExplore
              ? 'bg-rose-900 text-white shadow-sm shadow-rose-950/20'
              : 'text-stone-700 hover:text-rose-900 hover:bg-rose-50/80'
          }`}
        >
          <svg class={`w-4 h-4 ${isExplore ? 'text-amber-300' : 'text-stone-500'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2a10 10 0 1010 10A10 10 0 0012 2zm3.536 6.464l-2.122 5.656-5.656 2.122 2.122-5.656z" />
          </svg>
          <span>Explore Recipes</span>
        </a>

        <a
          href="/rasoi/favorites/"
          class={`relative flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200 ${
            isFavorites
              ? 'bg-rose-900 text-white shadow-sm shadow-rose-950/20'
              : 'text-stone-700 hover:text-rose-900 hover:bg-rose-50/80'
          }`}
        >
          <svg class={`w-4 h-4 ${isFavorites ? 'text-amber-300 fill-amber-300' : 'text-stone-500'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          <span>Favorites</span>
        </a>

        <a
          href="/rasoi/about/"
          class={`relative flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200 ${
            isAbout
              ? 'bg-rose-900 text-white shadow-sm shadow-rose-950/20'
              : 'text-stone-700 hover:text-rose-900 hover:bg-rose-50/80'
          }`}
        >
          <svg class={`w-4 h-4 ${isAbout ? 'text-amber-300' : 'text-stone-500'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>About</span>
        </a>
      </nav>

      {/* Right Actions & Portfolio Backlink */}
      <div class="flex items-center gap-2 sm:gap-3">
        {/* Back to Portfolio Link */}
        <a
          href="/"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-stone-700 hover:text-stone-900 bg-white hover:bg-stone-50 border border-stone-200 transition-colors shadow-2xs"
          title="Return to Main Portfolio"
        >
          <svg class="w-3.5 h-3.5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span class="hidden sm:inline">Portfolio</span>
        </a>

        <a
          href="/rasoi/explore/"
          class="p-2.5 rounded-full text-stone-700 hover:text-rose-900 hover:bg-rose-50 transition-colors border border-stone-200"
          aria-label="Search recipes"
          title="Search recipes"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>

        <a
          href="/rasoi/favorites/"
          class="p-2.5 rounded-full text-stone-700 hover:text-rose-900 hover:bg-rose-50 transition-colors border border-stone-200"
          aria-label="Saved Recipes"
          title="Saved Recipes"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </a>

        {/* Mobile Hamburger Navigation Details dropdown */}
        <details class="md:hidden relative group">
          <summary
            class="list-none p-2.5 rounded-xl text-stone-700 hover:text-rose-900 hover:bg-stone-100 transition-colors border border-stone-200 cursor-pointer"
            aria-label="Toggle navigation menu"
          >
            <svg class="w-5 h-5 block group-open:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg class="w-5 h-5 hidden group-open:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </summary>
          <div class="absolute right-0 top-full mt-2 w-56 p-3 rounded-2xl bg-[#faf7f2] border border-stone-200 shadow-xl space-y-1.5 z-50 animate-in slide-in-from-top-2">
            <a
              href="/rasoi/"
              class={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
                isHome ? 'bg-rose-900 text-white' : 'text-stone-800 hover:bg-rose-50'
              }`}
            >
              <span>Home</span>
            </a>
            <a
              href="/rasoi/explore/"
              class={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
                isExplore ? 'bg-rose-900 text-white' : 'text-stone-800 hover:bg-rose-50'
              }`}
            >
              <span>Explore Recipes</span>
            </a>
            <a
              href="/rasoi/favorites/"
              class={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
                isFavorites ? 'bg-rose-900 text-white' : 'text-stone-800 hover:bg-rose-50'
              }`}
            >
              <span>Saved Favorites</span>
            </a>
            <a
              href="/rasoi/about/"
              class={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
                isAbout ? 'bg-rose-900 text-white' : 'text-stone-800 hover:bg-rose-50'
              }`}
            >
              <span>About Rasoi</span>
            </a>
            <div class="pt-2 border-t border-stone-200">
              <a
                href="/"
                class="flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-medium text-stone-500 hover:text-stone-900 hover:bg-stone-100 transition-colors"
              >
                <span>Main Portfolio</span>
              </a>
              <a
                href="/vigyan/"
                class="flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-medium text-stone-500 hover:text-stone-900 hover:bg-stone-100 transition-colors"
              >
                <span>Vigyan 🔬</span>
              </a>
              <a
                href="/itihaas/"
                class="flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-medium text-stone-500 hover:text-stone-900 hover:bg-stone-100 transition-colors"
              >
                <span>Itihaas 🇮🇳</span>
              </a>
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
