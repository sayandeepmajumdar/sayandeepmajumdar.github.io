---
// Static Navbar for Vigyan (Zero-JS required)
---

<header class="sticky top-0 z-40 w-full border-b border-white/10 bg-[#080c14]/90 backdrop-blur-xl transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
    {/* Logo Branding */}
    <a
      href="/vigyan/"
      class="flex items-center gap-3 cursor-pointer group select-none"
      aria-label="Vigyan Science Timeline Home"
    >
      <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-sky-500 via-teal-400 to-emerald-400 p-[1px] shadow-lg shadow-sky-500/20 group-hover:scale-105 transition-transform">
        <div class="w-full h-full rounded-2xl bg-[#0b101c] flex items-center justify-center">
          <span class="text-xl">🔬</span>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xl sm:text-2xl font-black font-display tracking-wider bg-gradient-to-r from-sky-400 via-teal-300 to-emerald-300 bg-clip-text text-transparent">
            VIGYAN
          </span>
          <span class="text-[10px] uppercase font-bold tracking-widest px-2 py-0.5 rounded-full bg-sky-500/15 text-sky-300 border border-sky-500/30">
            विज्ञान
          </span>
        </div>
        <p class="text-[11px] text-stone-400 hidden sm:block">
          Science &amp; Discoveries Timeline
        </p>
      </div>
    </a>

    {/* Backlinks to Portfolio and Apps */}
    <nav class="flex items-center gap-2.5 sm:gap-3" aria-label="Quick links">
      <a
        href="/"
        class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-stone-300 hover:text-white border border-white/10 hover:bg-white/5 transition-colors"
      >
        <svg class="w-3.5 h-3.5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Portfolio</span>
      </a>

      <a
        href="/itihaas/"
        class="hidden sm:flex items-center gap-1 px-3 py-2 rounded-xl text-xs font-medium text-stone-400 hover:text-white border border-white/5 hover:border-white/20 transition-colors"
      >
        <span>Itihaas 🇮🇳</span>
        <svg class="w-3 h-3 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>

      <a
        href="/tools/"
        class="hidden sm:flex items-center gap-1 px-3 py-2 rounded-xl text-xs font-medium text-stone-400 hover:text-white border border-white/5 hover:border-white/20 transition-colors"
      >
        <span>Toolzy</span>
        <svg class="w-3 h-3 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>

      <a
        href="/rasoi/"
        class="hidden md:flex items-center gap-1 px-3 py-2 rounded-xl text-xs font-medium text-stone-400 hover:text-white border border-white/5 hover:border-white/20 transition-colors"
      >
        <span>Rasoi</span>
        <svg class="w-3 h-3 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>
    </nav>
  </div>
</header>
