---
// Static Footer for Vigyan (Zero-JS required)
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-[#06080e] text-stone-300 py-12 sm:py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
      {/* Brand Info */}
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2.5">
          <span class="text-2xl" aria-hidden="true">🔬</span>
          <span class="text-2xl font-black font-display tracking-wider bg-gradient-to-r from-sky-400 via-teal-300 to-emerald-300 bg-clip-text text-transparent">
            VIGYAN
          </span>
          <span class="text-xs uppercase font-bold tracking-widest px-2 py-0.5 rounded-full bg-sky-500/15 text-sky-300 border border-sky-500/30">
            विज्ञान
          </span>
        </div>
        <p class="text-stone-400 text-sm max-w-lg leading-relaxed">
          A single, continuous chronicle of scientific breakthroughs that reshaped human understanding. Written in clear, accessible language for inquiring minds aged 10 to 60.
        </p>
        <div class="flex items-center gap-4 text-xs text-stone-500 pt-1">
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Screen-reader accessible
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
            Jargon-free explanations
          </span>
        </div>
      </div>

      {/* Connected Projects */}
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-stone-200 mb-3">
          Explore More Sections
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="/itihaas/"
              class="inline-flex items-center gap-1.5 text-stone-400 hover:text-white transition-colors"
            >
              <span>Itihaas — Indian History &amp; Freedom</span>
              <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="/tools/"
              class="inline-flex items-center gap-1.5 text-stone-400 hover:text-white transition-colors"
            >
              <span>Toolzy — 70+ Developer Tools</span>
              <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="/rasoi/"
              class="inline-flex items-center gap-1.5 text-stone-400 hover:text-white transition-colors"
            >
              <span>Rasoi — Regional Indian Recipes</span>
              <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="/games/"
              class="inline-flex items-center gap-1.5 text-stone-400 hover:text-white transition-colors"
            >
              <span>Games — Arcade &amp; Puzzles</span>
              <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Credits */}
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p>
        © {currentYear} Vigyan · Created by{' '}
        <a
          href="/"
          class="text-stone-300 hover:text-sky-300 underline underline-offset-2"
        >
          Sayandeep Majumdar
        </a>
      </p>
      <p class="flex items-center gap-1">
        <span>Dedicated to human curiosity and scientific exploration</span>
        <span class="text-sky-400" aria-hidden="true">♥</span>
      </p>
    </div>
  </div>
</footer>
