---
import { GAME_CATEGORIES } from '../../data/games/categories';
---

<footer class="border-t border-line bg-surface/80 py-10 px-4 sm:px-8 mt-auto transition-colors">
  <div class="max-w-5xl mx-auto flex flex-col gap-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div>
        <div class="flex items-center justify-center sm:justify-start gap-2">
          <span class="text-base">🕹️</span>
          <span class="font-extrabold text-sm text-ink">ArcadeLab</span>
          <span class="text-xs text-muted">— A playground for browser games.</span>
        </div>
        <p class="text-xs text-muted mt-1 max-w-md">
          Real-time multiplayer duels, 3D sandboxes, and retro arcade classics powered by direct WebRTC peer-to-peer data channels and HTML5 Canvas.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-2 text-xs text-muted font-mono">
        <a href="/games/" class="hover:text-ink transition-colors">All Games</a>
        <span>•</span>
        {GAME_CATEGORIES.map((cat, i) => (
          <>
            <a href={`/games/${cat.slug}/`} class="hover:text-ink transition-colors">
              {cat.name}
            </a>
            {i < GAME_CATEGORIES.length - 1 && <span>•</span>}
          </>
        ))}
      </div>
    </div>

    <div class="pt-4 border-t border-line/60 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-muted">
      <p>© 2026 ArcadeLab • Created by <a href="/" class="text-ink font-medium hover:underline">sayandeep.dev</a></p>
      <div class="flex items-center gap-3">
        <a href="/tools/" class="hover:text-ink transition-colors">Tools</a>
        <a href="/yatra/" class="hover:text-ink transition-colors">Yatra</a>
        <a href="/rasoi/" class="hover:text-ink transition-colors">Rasoi</a>
        <a href="/itihaas/" class="hover:text-ink transition-colors">Itihaas</a>
        <a href="/vigyan/" class="hover:text-ink transition-colors">Vigyan</a>
      </div>
    </div>
  </div>
</footer>
