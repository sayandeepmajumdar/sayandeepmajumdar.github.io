---
interface Props {
  currentPath?: string;
}

const { currentPath = '/games/' } = Astro.props;
---

<header class="h-16 border-b border-line bg-surface/85 backdrop-blur-lg px-4 sm:px-8 flex items-center justify-between shrink-0 sticky top-0 z-40 transition-colors">
  <div class="flex items-center gap-3">
    <a href="/games/" class="flex items-center gap-2.5 text-ink hover:opacity-90 transition-opacity focus:outline-none">
      <span class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-pink-600 flex items-center justify-center text-white font-bold text-base shadow-md">
        🕹️
      </span>
      <div class="flex flex-col">
        <span class="font-black text-lg tracking-tight leading-none bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 bg-clip-text text-transparent">
          ArcadeLab
        </span>
        <span class="text-[10px] font-mono text-muted tracking-wide font-medium">
          A playground for browser games.
        </span>
      </div>
    </a>
  </div>

  <div class="flex items-center gap-2 sm:gap-3">
    {/* Theme Toggle */}
    <button
      id="games-theme-toggle"
      type="button"
      class="p-2 rounded-xl text-muted hover:text-ink hover:bg-surface-alt border border-line transition-colors cursor-pointer"
      title="Toggle Light/Dark Theme"
      aria-label="Toggle Theme"
    >
      <span id="games-theme-icon" class="text-sm">🌙</span>
    </button>

    <a
      href="/tools/"
      class="px-3 py-1.5 rounded-xl text-xs font-semibold text-muted hover:text-ink hover:bg-surface-alt border border-line transition-colors hidden sm:inline-flex"
    >
      Toolzy Hub
    </a>

    <a
      href="/"
      class="px-3 py-1.5 rounded-xl text-xs font-semibold text-ink bg-surface-alt border border-line hover:border-indigo-500 transition-colors"
    >
      Portfolio
    </a>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('games-theme-toggle');
    const icon = document.getElementById('games-theme-icon');

    function updateIcon() {
      const isDark = document.documentElement.classList.contains('dark');
      if (icon) icon.textContent = isDark ? '🌙' : '☀️';
    }

    updateIcon();

    if (btn) {
      btn.addEventListener('click', function () {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme-mode', isDark ? 'dark' : 'light');
          localStorage.setItem('toolbox:theme', isDark ? 'dark' : 'light');
        } catch (e) {}
        updateIcon();
      });
    }
  })();
</script>
