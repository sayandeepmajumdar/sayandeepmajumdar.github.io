---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { label: 'Map Discovery', path: '/yatra/', icon: 'map' },
  { label: 'Explore India', path: '/yatra/explore/', icon: 'compass' },
  { label: 'Bucket List', path: '/yatra/saved/', icon: 'heart', badgeId: 'yatra-saved-badge' },
];

function isLinkActive(linkPath: string): boolean {
  if (linkPath === '/yatra/' || linkPath === '/yatra') {
    return currentPath === '/yatra/' || currentPath === '/yatra';
  }
  return currentPath.startsWith(linkPath);
}
---

<header class="sticky top-0 z-40 w-full border-b border-white/10 bg-[#0c0f17]/90 backdrop-blur-xl transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
    <!-- Logo Branding -->
    <a
      href="/yatra/"
      class="flex items-center gap-3 cursor-pointer group select-none text-decoration-none"
    >
      <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-orange-600 via-amber-500 to-yellow-400 p-[1px] shadow-lg shadow-orange-500/20 group-hover:scale-105 transition-transform">
        <div class="w-full h-full rounded-2xl bg-[#0e1320] flex items-center justify-center">
          <span class="text-xl">✈️</span>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xl sm:text-2xl font-black font-display tracking-wider bg-gradient-to-r from-orange-400 via-amber-300 to-yellow-400 bg-clip-text text-transparent">
            YATRA
          </span>
          <span class="text-[10px] uppercase font-bold tracking-widest px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-400 border border-amber-500/30">
            India
          </span>
        </div>
        <p class="text-[11px] text-stone-400 hidden sm:block">
          Find your way through India
        </p>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-2">
      {navLinks.map((link) => {
        const active = isLinkActive(link.path);
        return (
          <a
            href={link.path}
            class={`flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium transition-all text-decoration-none ${
              active
                ? 'bg-white/10 text-white shadow-sm border border-white/10 font-semibold'
                : 'text-stone-400 hover:text-white hover:bg-white/5'
            }`}
          >
            {link.icon === 'map' && (
              <svg class={`w-4 h-4 ${active ? 'text-amber-400' : ''}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
            )}
            {link.icon === 'compass' && (
              <svg class={`w-4 h-4 ${active ? 'text-amber-400' : ''}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" stroke-width="2" />
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" stroke-width="2" fill="none" />
              </svg>
            )}
            {link.icon === 'heart' && (
              <svg class={`w-4 h-4 ${active ? 'text-amber-400' : ''}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            )}
            <span>{link.label}</span>
            {link.badgeId && (
              <span id={link.badgeId} class="hidden px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-rose-500 text-white">
                0
              </span>
            )}
          </a>
        );
      })}

      <!-- Return to Personal Portfolio / Tools -->
      <a
        href="/tools/"
        class="flex items-center gap-1.5 ml-4 px-3.5 py-2 rounded-xl text-xs font-medium text-stone-400 hover:text-stone-200 border border-white/5 hover:border-white/20 transition-colors"
      >
        <span>Developer Tools</span>
        <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>
    </nav>

    <!-- Mobile Actions & Hamburger Button -->
    <div class="flex items-center gap-3 md:hidden">
      <a
        href="/yatra/saved/"
        class="relative p-2 rounded-xl text-stone-300 hover:text-white"
        aria-label="Saved Destinations"
      >
        <svg class="w-5 h-5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        <span id="yatra-saved-badge-mobile" class="hidden absolute top-1 right-1 w-4 h-4 rounded-full bg-rose-500 text-white text-[10px] font-bold flex items-center justify-center">
          0
        </span>
      </a>
      <button
        id="yatra-mobile-menu-toggle"
        class="p-2 rounded-xl text-stone-300 hover:text-white hover:bg-white/10 transition-colors"
        aria-label="Toggle Menu"
      >
        <svg id="yatra-menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="yatra-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="yatra-mobile-drawer" class="hidden md:hidden border-t border-white/10 bg-[#0c0f17]/95 backdrop-blur-2xl p-4 space-y-2">
    {navLinks.map((link) => {
      const active = isLinkActive(link.path);
      return (
        <a
          href={link.path}
          class={`w-full flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium transition-all ${
            active
              ? 'bg-amber-500/20 text-white font-semibold border border-amber-500/30'
              : 'text-stone-300 hover:bg-white/5'
          }`}
        >
          <div class="flex items-center gap-3">
            {link.icon === 'map' && (
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
            )}
            {link.icon === 'compass' && (
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" stroke-width="2" />
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" stroke-width="2" fill="none" />
              </svg>
            )}
            {link.icon === 'heart' && (
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            )}
            <span>{link.label}</span>
          </div>
        </a>
      );
    })}

    <div class="pt-2 border-t border-white/10 flex items-center justify-between text-xs text-stone-400">
      <a href="/" class="hover:text-white flex items-center gap-1 py-1">
        <span>Main Portfolio</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>
      <a href="/rasoi/" class="hover:text-white flex items-center gap-1 py-1">
        <span>Rasoi</span>
      </a>
      <a href="/tools/" class="hover:text-white flex items-center gap-1 py-1">
        <span>Tools</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Mobile drawer toggle
  const toggleBtn = document.getElementById('yatra-mobile-menu-toggle');
  const drawer = document.getElementById('yatra-mobile-drawer');
  const menuIcon = document.getElementById('yatra-menu-icon');
  const closeIcon = document.getElementById('yatra-close-icon');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = drawer.classList.contains('hidden');
      if (isHidden) {
        drawer.classList.remove('hidden');
        menuIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      } else {
        drawer.classList.add('hidden');
        menuIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    });
  }

  // Sync bucket list badge from localStorage
  function updateYatraSavedBadges() {
    try {
      const stored = localStorage.getItem('yatra_saved_destinations');
      const saved = stored ? JSON.parse(stored) : [];
      const count = Array.isArray(saved) ? saved.length : 0;
      
      const badge = document.getElementById('yatra-saved-badge');
      const badgeMobile = document.getElementById('yatra-saved-badge-mobile');

      if (count > 0) {
        if (badge) {
          badge.textContent = String(count);
          badge.classList.remove('hidden');
        }
        if (badgeMobile) {
          badgeMobile.textContent = String(count);
          badgeMobile.classList.remove('hidden');
        }
      } else {
        badge?.classList.add('hidden');
        badgeMobile?.classList.add('hidden');
      }
    } catch (e) {
      // ignore
    }
  }

  updateYatraSavedBadges();
  window.addEventListener('storage', updateYatraSavedBadges);
</script>
