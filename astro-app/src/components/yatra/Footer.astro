---
const regions = [
  'North',
  'South',
  'East',
  'West',
  'Central',
  'Northeast',
  'Islands',
];
---

<footer class="w-full border-t border-white/10 bg-[#080b12] text-stone-400 py-12 px-4 sm:px-6 lg:px-8 mt-20">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
    <!-- Brand Column -->
    <div class="md:col-span-2 space-y-3">
      <div class="flex items-center gap-2">
        <span class="text-2xl font-black font-display tracking-wider bg-gradient-to-r from-orange-400 to-amber-300 bg-clip-text text-transparent">
          YATRA
        </span>
        <span class="text-[10px] uppercase font-bold tracking-widest px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-400 border border-amber-500/30">
          India
        </span>
      </div>
      <p class="text-sm text-stone-400 max-w-md leading-relaxed">
        An authentic exploration of India's ancient civilization, majestic Himalayas, tranquil backwaters, royal desert citadels, and lush rainforests. Pre-rendered with Astro SSG for instant, high-performance static delivery.
      </p>
      <div class="text-xs text-stone-500 flex items-center gap-1.5 pt-2">
        <span>Static HTML Generation • Island Hydration • 119 Destination Guides</span>
      </div>
    </div>

    <!-- Regions Column -->
    <div>
      <h5 class="text-xs font-semibold text-stone-200 uppercase tracking-wider mb-3">
        Explore By Region
      </h5>
      <ul class="space-y-1.5 text-xs">
        {regions.map((region) => (
          <li>
            <a
              href={`/yatra/explore/?region=${encodeURIComponent(region)}`}
              class="hover:text-amber-400 transition-colors text-stone-400"
            >
              {region} India
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Navigation Column -->
    <div>
      <h5 class="text-xs font-semibold text-stone-200 uppercase tracking-wider mb-3">
        Navigation
      </h5>
      <ul class="space-y-1.5 text-xs">
        <li>
          <a href="/yatra/" class="hover:text-amber-400 transition-colors text-stone-400">
            Interactive Map Discovery
          </a>
        </li>
        <li>
          <a href="/yatra/explore/" class="hover:text-amber-400 transition-colors text-stone-400">
            Destination Matrix
          </a>
        </li>
        <li>
          <a href="/yatra/saved/" class="hover:text-amber-400 transition-colors text-stone-400">
            Saved Bucket List
          </a>
        </li>
        <li>
          <a href="/rasoi/" class="hover:text-amber-400 transition-colors text-stone-400">
            Rasoi — Authentic Indian Recipes
          </a>
        </li>
        <li>
          <a href="/itihaas/" class="hover:text-amber-400 transition-colors text-stone-400">
            Itihaas — Indian History Archive
          </a>
        </li>
        <li>
          <a href="/vigyan/" class="hover:text-amber-400 transition-colors text-stone-400">
            Vigyan — Indian Discoveries
          </a>
        </li>
        <li>
          <a href="/tools/" class="hover:text-amber-400 transition-colors text-stone-400">
            Developer Toolbox
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="max-w-7xl mx-auto pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between text-xs text-stone-500 gap-4">
    <div>
      © {new Date().getFullYear()} Yatra • Sayandeep Majumdar. All rights reserved.
    </div>
    <div class="flex items-center gap-1">
      <span>Crafted with</span>
      <span class="text-rose-500">♥</span>
      <span>for curious travelers</span>
    </div>
  </div>
</footer>
