---
const STYLES = [
  {
    id: 'Adventure',
    label: 'Adventure',
    tagline: 'Trekking & Rafting',
    emoji: '🏔️',
    gradient: 'from-orange-500/20 to-amber-500/20 border-orange-500/30',
  },
  {
    id: 'Spiritual',
    label: 'Spiritual',
    tagline: 'Ghats & Ashrams',
    emoji: '✨',
    gradient: 'from-purple-500/20 to-indigo-500/20 border-purple-500/30',
  },
  {
    id: 'History',
    label: 'Heritage',
    tagline: 'Forts & Palaces',
    emoji: '🏛️',
    gradient: 'from-amber-500/20 to-yellow-500/20 border-amber-500/30',
  },
  {
    id: 'Nature',
    label: 'Nature',
    tagline: 'Lakes & Forests',
    emoji: '🌲',
    gradient: 'from-emerald-500/20 to-teal-500/20 border-emerald-500/30',
  },
  {
    id: 'Food',
    label: 'Culinary',
    tagline: 'Street Food & Spices',
    emoji: '🍲',
    gradient: 'from-rose-500/20 to-orange-500/20 border-rose-500/30',
  },
  {
    id: 'Romantic',
    label: 'Romantic',
    tagline: 'Lakes & Quiet Hills',
    emoji: '💖',
    gradient: 'from-pink-500/20 to-rose-500/20 border-pink-500/30',
  },
  {
    id: 'Photography',
    label: 'Visual Trails',
    tagline: 'Golden Hour Vistas',
    emoji: '📸',
    gradient: 'from-blue-500/20 to-cyan-500/20 border-blue-500/30',
  },
  {
    id: 'Backpacking',
    label: 'Backpacking',
    tagline: 'Hostels & Valleys',
    emoji: '🎒',
    gradient: 'from-teal-500/20 to-emerald-500/20 border-teal-500/30',
  },
  {
    id: 'Family',
    label: 'Family Getaways',
    tagline: 'Safe, Memorable Escapes',
    emoji: '👨‍👩‍👧‍👦',
    gradient: 'from-amber-500/20 to-orange-500/20 border-amber-500/30',
  },
  {
    id: 'Relax',
    label: 'Slow Travel',
    tagline: 'Backwaters & Coastal',
    emoji: '⛵',
    gradient: 'from-cyan-500/20 to-sky-500/20 border-cyan-500/30',
  },
];
---

<div class="w-full">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h3 class="text-xl sm:text-2xl font-bold font-display text-white">
        How do you want to travel?
      </h3>
      <p class="text-xs sm:text-sm text-stone-400 mt-0.5">
        Discover destinations shaped around your rhythm and passions
      </p>
    </div>
  </div>

  <div class="flex gap-3 overflow-x-auto pb-3 pt-1 scrollbar-none snap-x">
    {STYLES.map((style) => (
      <a
        href={`/yatra/explore/?style=${encodeURIComponent(style.id)}`}
        class="flex-shrink-0 snap-start p-4 rounded-2xl glass-card border border-white/10 hover:border-amber-500/40 transition-all duration-300 w-44 sm:w-48 text-left group active:scale-95 text-decoration-none"
      >
        <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3 bg-white/10 text-stone-300 group-hover:bg-amber-500/20 group-hover:text-amber-400 transition-colors text-xl">
          <span>{style.emoji}</span>
        </div>
        <div class="font-semibold text-sm text-white group-hover:text-amber-300 transition-colors">
          {style.label}
        </div>
        <div class="text-[11px] text-stone-400 truncate mt-0.5">
          {style.tagline}
        </div>
      </a>
    ))}
  </div>
</div>
