---
import { getTrendingDestinations } from '../../data/yatra/destinations';

const trendingDestinations = getTrendingDestinations().slice(0, 8);
---

<section class="w-full">
  <div class="flex items-center justify-between mb-4">
    <div>
      <div class="flex items-center gap-1.5 text-xs font-semibold text-amber-500 uppercase tracking-wider mb-0.5">
        <span>✨</span>
        <span>Curated Picks</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-bold font-display text-white">
        Trending Across India
      </h3>
    </div>
    <a
      href="/yatra/explore/"
      class="text-xs text-amber-400 hover:text-amber-300 transition-colors font-medium"
    >
      View All 119 Destinations →
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {trendingDestinations.map((dest) => (
      <div class="group rounded-2xl glass-card overflow-hidden border border-white/10 hover:border-amber-500/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-amber-500/10 flex flex-col justify-between">
        <!-- Card Image Banner -->
        <a href={`/yatra/destination/${dest.id}/`} class="relative h-44 w-full overflow-hidden bg-stone-800 block">
          <img
            src={dest.image}
            alt={dest.name}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20" />

          <!-- Region & Category Badge -->
          <div class="absolute top-3 left-3 flex items-center gap-1.5">
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-500/90 text-stone-950 backdrop-blur-md">
              {dest.categories[0]}
            </span>
          </div>

          <!-- State Name -->
          <div class="absolute bottom-3 left-3 text-xs text-stone-300 flex items-center gap-1">
            <span class="text-amber-400">📍</span>
            <span>{dest.state}</span>
          </div>
        </a>

        <!-- Card Content -->
        <div class="p-4 flex-1 flex flex-col justify-between space-y-2">
          <div>
            <a href={`/yatra/destination/${dest.id}/`}>
              <h4 class="text-base font-bold text-white group-hover:text-amber-400 transition-colors">
                {dest.name}
              </h4>
            </a>
            <p class="text-xs text-stone-400 line-clamp-2 mt-1 leading-relaxed">
              {dest.description}
            </p>
          </div>

          <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[11px] text-stone-400">
            <span>{dest.bestTime}</span>
            <a
              href={`/yatra/?dest=${dest.id}`}
              class="flex items-center gap-1 text-amber-400 font-semibold hover:underline"
            >
              <span>✈️ Fly on Map</span>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
