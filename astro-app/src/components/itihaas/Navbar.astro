---
import { ERAS } from '../../data/itihaas/eras';
import type { EraId } from '../../types/itihaas';
import { MobileNav } from './MobileNav';

interface Props {
  currentPath: string;
  activeEraId?: EraId;
}

const { currentPath, activeEraId } = Astro.props;
const isHome = currentPath === '/itihaas/' || currentPath === '/itihaas';
---

<header class="sticky top-0 z-40 w-full border-b border-white/10 bg-[#0a0d14]/90 backdrop-blur-xl transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
    <!-- Logo Branding -->
    <a
      href="/itihaas/"
      class="flex items-center gap-3 cursor-pointer group select-none"
      aria-label="Itihaas Home — Chronicles of Indian History"
    >
      <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-amber-600 via-orange-500 to-yellow-400 p-[1px] shadow-lg shadow-orange-500/20 group-hover:scale-105 transition-transform">
        <div class="w-full h-full rounded-2xl bg-[#0e1320] flex items-center justify-center">
          <span class="text-xl">🇮🇳</span>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xl sm:text-2xl font-black font-display tracking-wider bg-gradient-to-r from-amber-400 via-orange-300 to-yellow-400 bg-clip-text text-transparent">
            ITIHAAS
          </span>
          <span class="text-[10px] uppercase font-bold tracking-widest px-2 py-0.5 rounded-full bg-orange-500/15 text-orange-400 border border-orange-500/30">
            इतिहास
          </span>
        </div>
        <p class="text-[11px] text-stone-400 hidden sm:block">
          Chronicles of India &amp; Freedom Struggle
        </p>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1.5" aria-label="Main Era Navigation">
      <a
        href="/itihaas/"
        class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all ${
          isHome
            ? 'bg-white/15 text-white shadow-sm border border-white/20'
            : 'text-stone-400 hover:text-white hover:bg-white/5'
        }`}
      >
        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="2" />
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" stroke-width="2" />
        </svg>
        <span>Eras Overview</span>
      </a>

      {ERAS.map((era) => {
        const isEraActive = activeEraId === era.id && !isHome;
        return (
          <a
            href={`/itihaas/${era.slug}/`}
            class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium transition-all ${
              isEraActive
                ? 'bg-white/15 text-white border border-white/20 font-bold shadow-sm'
                : 'text-stone-400 hover:text-white hover:bg-white/5'
            }`}
            style={isEraActive ? { borderColor: era.accentColor } : {}}
          >
            <span
              class="w-2 h-2 rounded-full"
              style={{ backgroundColor: era.accentColor }}
              aria-hidden="true"
            />
            <span>{era.name}</span>
          </a>
        );
      })}
    </nav>

    <!-- External Links to Other Portfolio Sections -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/"
        class="flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-medium text-stone-400 hover:text-stone-200 border border-white/5 hover:border-white/20 transition-colors"
        title="Return to Sayandeep Majumdar Homepage"
      >
        <svg class="w-3 h-3 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Portfolio</span>
      </a>

      <a
        href="/rasoi/"
        class="flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-medium text-stone-400 hover:text-stone-200 border border-white/5 hover:border-white/20 transition-colors"
      >
        <span>Rasoi</span>
        <svg class="w-3 h-3 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>

      <a
        href="/yatra/"
        class="flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-medium text-stone-400 hover:text-stone-200 border border-white/5 hover:border-white/20 transition-colors"
      >
        <span>Yatra</span>
        <svg class="w-3 h-3 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>
    </div>

    <!-- Mobile Drawer Menu Island -->
    <MobileNav currentPath={currentPath} activeEraId={activeEraId} client:idle />
  </div>
</header>
