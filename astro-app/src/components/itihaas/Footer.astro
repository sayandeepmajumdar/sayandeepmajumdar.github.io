---
import { ERAS } from '../../data/itihaas/eras';
---

<footer class="border-t border-white/10 bg-[#07090e] text-stone-300 py-12 sm:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Brand Col -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <span class="text-2xl">🇮🇳</span>
          <span class="text-2xl font-black font-display tracking-wider bg-gradient-to-r from-amber-400 via-orange-300 to-yellow-400 bg-clip-text text-transparent">
            ITIHAAS
          </span>
          <span class="text-xs uppercase font-bold tracking-widest px-2 py-0.5 rounded-full bg-orange-500/15 text-orange-400 border border-orange-500/30">
            इतिहास
          </span>
        </div>
        <p class="text-sm text-stone-400 max-w-md leading-relaxed">
          An interactive historical chronicle celebrating the multi-millennial civilization of India and the heroic 90-year Freedom Struggle (1857–1947). Built with structured timeline data, cross-era figure tracking, and educational recap quizzes.
        </p>
        <div class="flex items-center gap-4 text-xs text-stone-500 pt-2">
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Screen-reader accessible
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Historically referenced
          </span>
        </div>
      </div>

      <!-- Historical Eras -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-stone-200 mb-4">
          Historical Eras
        </h3>
        <ul class="space-y-2 text-sm">
          {ERAS.map((era) => (
            <li>
              <a
                href={`/itihaas/${era.slug}/`}
                class="flex items-center gap-2 text-stone-400 hover:text-stone-100 transition-colors group text-left"
              >
                <span
                  class="w-2 h-2 rounded-full transition-transform group-hover:scale-125"
                  style={{ backgroundColor: era.accentColor }}
                  aria-hidden="true"
                />
                <span>{era.name}</span>
                <span class="text-[11px] text-stone-400 font-mono">
                  ({era.milestoneCount})
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Portfolio & Connected Explorations -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-stone-200 mb-4">
          Portfolio &amp; Projects
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              href="/"
              class="inline-flex items-center gap-1.5 text-stone-400 hover:text-white transition-colors"
            >
              <span>Sayandeep Majumdar Portfolio</span>
              <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="/rasoi/"
              class="inline-flex items-center gap-1.5 text-stone-400 hover:text-white transition-colors"
            >
              <span>Rasoi — Regional Indian Recipes</span>
              <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="/yatra/"
              class="inline-flex items-center gap-1.5 text-stone-400 hover:text-white transition-colors"
            >
              <span>Yatra — Interactive Travel Map</span>
              <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="/tools/"
              class="inline-flex items-center gap-1.5 text-stone-400 hover:text-white transition-colors"
            >
              <span>Developer Toolbox (70+ Tools)</span>
              <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="/games/"
              class="inline-flex items-center gap-1.5 text-stone-400 hover:text-white transition-colors"
            >
              <span>Browser Games Hub</span>
              <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Credits & Copyright -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-400">
      <p>
        © {new Date().getFullYear()} Itihaas · Curated &amp; engineered by{' '}
        <a
          href="/"
          class="text-stone-300 hover:text-amber-400 underline underline-offset-2"
        >
          Sayandeep Majumdar
        </a>
      </p>
      <p class="flex items-center gap-1">
        <span>Crafted with devotion to India’s heritage &amp; freedom fighters</span>
        <span class="text-rose-500">❤️</span>
      </p>
    </div>
  </div>
</footer>
