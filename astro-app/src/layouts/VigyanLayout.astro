---
import '../styles/vigyan.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title = 'VIGYAN — Science & Discoveries Timeline | History of Human Knowledge',
  description = 'Explore 500+ years of breakthrough scientific discoveries, from the heliocentric cosmos to mRNA vaccines. Interactive continuous timeline with live search and plain-language stories for all ages.',
  canonicalUrl = 'https://sayandeepmajumdar.github.io/vigyan/',
  ogImage = 'https://images.unsplash.com/photo-1507668077129-56e32842fceb?auto=format&fit=crop&w=1200&q=80',
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'VIGYAN',
  url: canonicalUrl,
  applicationCategory: 'EducationalApplication',
  description: description,
  operatingSystem: 'All',
  publisher: {
    '@type': 'Organization',
    name: 'Vigyan',
    url: 'https://sayandeepmajumdar.github.io/vigyan/',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="science timeline, scientific discoveries, history of science, newton, copernicus, galileo, darwin, curie, einstein, fleming, human genome, higgs boson, gravitational waves, mrna vaccine, physics, chemistry, biology, astronomy, medicine, technology, space"
    />
    <meta name="author" content="Sayandeep Majumdar · Vigyan" />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🔬</text></svg>"
    />

    <!-- OpenGraph Social Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="VIGYAN — Science & Discoveries Timeline" />
    <meta
      name="twitter:description"
      content="Explore 500+ years of breakthrough scientific discoveries on an interactive continuous timeline."
    />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts: Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />
  </head>
  <body class="bg-[#06080e] text-stone-100 min-h-screen flex flex-col font-sans antialiased selection:bg-sky-500 selection:text-white">
    <slot name="header" />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
