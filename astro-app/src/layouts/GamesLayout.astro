---
import Header from '../components/games/Header.astro';
import Footer from '../components/games/Footer.astro';
import '../styles/games.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  currentPath?: string;
}

const {
  title = 'ArcadeLab — A playground for browser games.',
  description = 'ArcadeLab — A playground for browser games. Real-time multiplayer duels, 3D WebGL sandboxes, and casual arcade games with zero servers and instant WebRTC peer-to-peer networking.',
  canonicalUrl = 'https://sayandeepmajumdar.github.io/games/',
  ogImage = 'https://sayandeepmajumdar.github.io/assets/images/arcadelab-og.png',
  currentPath = '/games/',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="browser games, webrtc games, multiplayer games, online chess, 3d racing, voxel sandbox, flappy bird, snake, rock paper scissors, sudoku, hangman" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🕹️</text></svg>" />

  <!-- Google Fonts: Inter, JetBrains Mono, Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- OpenGraph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Schema.org WebApplication JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "ArcadeLab",
    "url": "https://sayandeepmajumdar.github.io/games/",
    "description": "A playground for real-time multiplayer and singleplayer browser games powered by WebRTC P2P and HTML5 Canvas.",
    "applicationCategory": "GameApplication",
    "operatingSystem": "All modern browsers",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  }
  </script>

  <!-- Inline Theme Initialization (prevents flash of unstyled content) -->
  <script is:inline>
    (function () {
      try {
        var mode = localStorage.getItem("theme-mode") || localStorage.getItem("toolbox:theme");
        var isDark = mode === "dark" || (!mode && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (isDark) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      } catch (e) {}
    })();
  </script>
</head>
<body class="min-h-screen flex flex-col antialiased bg-grid selection:bg-indigo-500 selection:text-white transition-colors duration-200">
  <Header currentPath={currentPath} />
  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-10 sm:py-12">
    <slot />
  </main>
  <Footer />
</body>
</html>
